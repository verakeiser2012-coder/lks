# Скопируйте этот файл в .env и заполните значения

# Порт, на котором запускается сайт
PORT=3000

# Секрет для подписи сессий (любая длинная случайная строка)
SESSION_SECRET=change-me-to-a-long-random-string

# Учётные данные администратора — используются один раз скриптом npm run db:seed,
# чтобы создать первого админа. После первого запуска можно сменить пароль в БД.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Название сайта (можно потом изменить в админке -> Настройки)
SITE_NAME=Мой магазин

# --- Оплата (ЮKassa) ---
# Пока не заполнено — оплата работает в тестовом режиме (заглушка).
# Получите shopId и секретный ключ в личном кабинете ЮKassa (https://yookassa.ru/)
# и впишите их сюда, чтобы включить реальные платежи.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Уведомления на почту о новых заявках (бренды, «Рыжие») ---
# Пока не заполнено — уведомления просто пишутся в консоль сервера вместо отправки.
# 1. Включите двухфакторную аутентификацию на аккаунте Gmail, который будет отправлять письма.
# 2. Создайте пароль приложения: https://myaccount.google.com/apppasswords
# 3. Впишите сюда сам Gmail-адрес и 16-значный пароль приложения (без пробелов).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# На какой адрес приходят уведомления. Если пусто — уходит на GMAIL_USER.
NOTIFY_EMAIL=djlevka2012@gmail.com
