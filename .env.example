# Скопируйте этот файл в .env и заполните значения

# Порт, на котором запускается сайт
PORT=3000

# Секрет для подписи сессий (любая длинная случайная строка)
SESSION_SECRET=change-me-to-a-long-random-string

# Учётные данные администратора — используются один раз скриптом npm run db:seed,
# чтобы создать первого админа. После первого запуска можно сменить пароль в БД.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Название сайта (можно потом изменить в админке -> Настройки)
SITE_NAME=Мой магазин

# --- Оплата (ЮKassa) ---
# Пока не заполнено — оплата работает в тестовом режиме (заглушка).
# Получите shopId и секретный ключ в личном кабинете ЮKassa (https://yookassa.ru/)
# и впишите их сюда, чтобы включить реальные платежи.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Эквайринг Альфа-Банка — принимает иностранные карты (в отличие от ЮKassa).
# Пока не заполнено — src/services/payments/alfabank.js работает в тестовом режиме.
# Впишите логин/пароль ИЛИ токен API из личного кабинета партнёра Альфа-Банка.
# Модуль пока не подключён к чекауту — это подготовка на будущее.
ALFA_API_LOGIN=
ALFA_API_PASSWORD=
ALFA_API_TOKEN=
# Боевой адрес шлюза, если отличается от тестового стенда (alfa.rbsuat.com) —
# уточните в личном кабинете партнёра.
ALFA_GATEWAY_URL=

# --- Уведомления на почту о новых заявках (бренды, «Рыжие», конкурс) ---
# Пока не заполнено — уведомления просто пишутся в консоль сервера вместо отправки.
# Почта на Яндекс 360: smtp.yandex.ru, порт 465.
# 1. Зайдите в почту info@levkeiser.com -> Настройки -> Пароли и почтовые программы.
# 2. Создайте пароль приложения для почтового клиента.
# 3. Впишите сюда адрес info@levkeiser.com и созданный пароль приложения.
SMTP_USER=info@levkeiser.com
SMTP_PASSWORD=
# На какой адрес приходят уведомления по умолчанию (заявки «Рыжие», конкурс).
# Заявки от брендов отдельно уходят на brand@levkeiser.com.
NOTIFY_EMAIL=info@levkeiser.com
