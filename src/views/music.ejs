<%- include('partials/header') %>

<section class="hero">
  <h1>Музыка</h1>
  <% if (intro) { %><p class="hero-tagline"><%- renderLinkedText(intro) %></p><% } %>
</section>

<% if (featured && featured.title) { %>
  <section class="featured-release">
    <p class="featured-eyebrow">Сейчас</p>
    <h2 class="featured-title"><%= featured.title %></h2>
    <% if (featured.note) { %><p class="featured-note"><%= featured.note %></p><% } %>
    <% if (featured.url) { %><a class="btn featured-listen" href="<%= featured.url %>" target="_blank" rel="noopener">Слушать</a><% } %>
  </section>
<% } %>

<% if (releases.length > 0) { %>
  <section class="link-section">
    <h2>Альбомы</h2>
    <div class="table-scroll">
      <table class="music-table">
        <thead>
          <tr>
            <th class="music-table-cover-col"></th>
            <th>Название</th>
            <th>Тип</th>
            <th>Год</th>
            <th>Треков</th>
          </tr>
        </thead>
        <tbody>
          <% releases.forEach(function(release) { %>
            <tr>
              <td class="music-table-cover-col">
                <a href="/music/<%= release.slug %>">
                  <% if (release.cover_image) { %><img class="music-table-cover" src="<%= release.cover_image %>" alt="<%= release.title %>"><% } %>
                </a>
              </td>
              <td><a class="music-table-title" href="/music/<%= release.slug %>"><%= release.title %></a></td>
              <td><%= release.release_type %></td>
              <td><%= release.year %></td>
              <td><%= release.trackCount %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>
<% } %>

<% if (tracks.length > 0) { %>
  <section class="link-section">
    <h2>Синглы</h2>
    <div class="table-scroll">
      <table class="music-table">
        <thead>
          <tr>
            <th class="music-table-cover-col"></th>
            <th>Название</th>
            <th>Описание</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% tracks.forEach(function(track) { %>
            <tr>
              <td class="music-table-cover-col">
                <% if (track.cover_image) { %><img class="music-table-cover" src="<%= track.cover_image %>" alt="<%= track.title %>"><% } %>
              </td>
              <td class="music-table-title"><%= track.title %></td>
              <td class="music-table-desc"><% if (track.description) { %><%- renderLinkedText(track.description) %><% } %></td>
              <td><% if (track.url) { %><a class="music-table-listen" href="<%= track.url %>" target="_blank" rel="noopener">Слушать →</a><% } %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>
<% } %>

<section class="link-section">
  <h2>Слушать</h2>
  <div class="player-embed-grid">
    <iframe class="player-embed" src="https://open.spotify.com/embed/artist/2Yk65GNoUclS0VKtyvCebY" width="100%" height="352" frameborder="0" allow="encrypted-media" loading="lazy"></iframe>
    <iframe class="player-embed" src="https://embed.music.apple.com/us/artist/dj-levka/1631413541" width="100%" height="352" frameborder="0" allow="autoplay *; encrypted-media *;" loading="lazy"></iframe>
  </div>
</section>

<%- include('partials/gallery-section', { galleryItems: galleryItems, galleryTitle: 'Со студии и концертов' }) %>

<% groups.forEach(function(group) { %>
  <section class="link-section">
    <% if (group.name) { %><h2><%= group.name %></h2><% } %>
    <div class="link-grid">
      <% group.items.forEach(function(link) { %>
        <a class="link-card" href="<%= link.url %>" target="_blank" rel="noopener"><%= link.label %></a>
      <% }); %>
    </div>
  </section>
<% }); %>

<%- include('partials/footer') %>
