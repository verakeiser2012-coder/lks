<%- include('partials/header') %>

<%# Свои ролики (анимации из public/video) — отдельной сеткой 9:16, остальное
    (клипы с YouTube/Rutube, кадры со съёмок) — в общей плёнке ниже. %>
<% var anims = trackGalleryItems.filter(function (i) { return i.type === 'video' && /^\/video\//.test(i.file_path); }); %>
<% var otherItems = trackGalleryItems.filter(function (i) { return anims.indexOf(i) === -1; }); %>

<section class="hero release-hero">
  <% if (track.cover_image) { %><img class="release-hero-cover" src="<%= thumb(track.cover_image, 480) %>" srcset="<%= srcset(track.cover_image, [320, 480, 640, 960]) %>" sizes="(max-width: 480px) 92vw, 200px" alt="<%= track.title %>"><% } %>
  <div>
    <p class="drop-season"><a href="/music/<%= release.slug %>"><%= release.title %></a></p>
    <h1><%= track.title %></h1>
    <%# Слушать можно прямо здесь: раньше единственная кнопка уводила на чужую
        площадку, и человек уходил с сайта, не дочитав про трек. %>
    <% if (track.audio) { %>
      <audio class="track-player" controls preload="none" src="<%= track.audio %>"></audio>
    <% } %>
    <%# Прямые кнопки на площадки. Когда у релиза они заведены, ведём сразу туда,
        без band.link. Пока не заведены — прежняя пара «Spotify / все площадки». %>
    <% if (platformButtons.length) { %>
      <p class="track-links-title">Добавить в свой плейлист</p>
      <%- include('partials/platform-links') %>
      <p class="track-links-hint">Откроется страница релиза на площадке — там «Мне нравится» или «В плейлист».</p>
    <% } else { %>
      <%# Подпись кнопки зависит от того, куда она ведёт. У части синглов общей
          ссылки на все площадки нет, только Spotify, и «добавить в плейлист»
          обещало то, чего кнопка не делала. %>
      <% var smart = /band\.link/i.test(release.streaming_url || '') ? release.streaming_url : ''; %>
      <% var spotify = /spotify\.com/i.test(release.streaming_url || '') ? release.streaming_url : (/spotify\.com/i.test(track.url || '') ? track.url : ''); %>
      <div class="track-links">
        <% if (smart) { %>
          <a class="btn" href="<%= smart %>" target="_blank" rel="noopener">Добавить в свой плейлист</a>
        <% } else { %>
          <% if (spotify) { %><a class="btn" href="<%= spotify %>" target="_blank" rel="noopener">Открыть в Spotify</a><% } %>
          <a class="btn btn-ghost" href="https://band.link/djlevka" target="_blank" rel="noopener">Все площадки</a>
        <% } %>
      </div>
      <% if (smart) { %>
        <p class="track-links-hint">Одна ссылка на все площадки: Яндекс Музыка, ВК, Звук, Spotify, Apple Music. Открывается там, где вы слушаете.</p>
      <% } else { %>
        <p class="track-links-hint">У этого сингла пока нет общей ссылки на все площадки. «Все площадки» ведёт на каталог артиста: там трек найдётся в Яндекс Музыке, ВК, Звуке и Apple Music.</p>
      <% } %>
    <% } %>
  </div>
</section>

<% if (trackVideo) { %>
<section class="link-section">
  <h2>Клип</h2>
  <div class="video-embed <%= track.video_format === 'portrait' ? 'is-portrait' : '' %>">
    <iframe src="<%= trackVideo.embedUrl %>" loading="lazy" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen title="Клип: <%= track.title %>"></iframe>
  </div>
</section>
<% } %>

<% if (track.description) { %>
  <div class="prose drop-description"><%- renderLinkedText(track.description) %></div>
<% } %>

<% if (anims.length) { %>
<section class="link-section">
  <h2>Анимации к треку <span class="music-strip-hint">· крутятся без звука, звук — кнопкой</span></h2>
  <%# Кинолента: ролики идут сами и молча (иначе браузер не даст автозапуск),
      звук включается на одном по кнопке — см. public/js/anim-strip.js. %>
  <div class="filmstrip anim-strip"><div class="filmstrip-track">
    <% anims.forEach(function (a, i) { %>
      <div class="film-cell anim-cell" data-code="DJ LEVKA · <%= track.title.toUpperCase() %>" data-num="КАДР <%= String(i + 1).padStart(2, '0') %>">
        <div class="anim-frame edge-soft">
          <video src="<%= a.file_path %>" muted loop playsinline preload="metadata" title="<%= a.title %>"></video>
          <button type="button" class="anim-sound" aria-pressed="false">🔇 звук</button>
        </div>
      </div>
    <% }); %>
  </div></div>
</section>
<script src="/js/anim-strip.js" defer></script>
<% } %>

<% if (products && products.length) { %>
<section class="link-section">
  <h2>Вещи к этому треку</h2>
  <div class="product-grid">
    <% products.forEach(function(product) { %>
      <a class="product-card" href="/catalog/<%= product.slug %>">
        <div class="product-image edge-soft">
          <% if (product.image) { %>
            <img src="<%= thumb(product.image, 640) %>" srcset="<%= srcset(product.image) %>" sizes="(max-width: 640px) 92vw, (max-width: 1000px) 46vw, 300px" alt="<%= product.name %>">
          <% } else { %>
            <div class="no-image">Нет фото</div>
          <% } %>
        </div>
        <div class="product-name"><%= product.name %></div>
        <div class="product-price"><%= priceLabel(product) %></div>
      </a>
    <% }); %>
  </div>
</section>
<% } %>

<%- include('partials/gallery-section', { galleryItems: otherItems, galleryTitle: 'Видео и кадры к треку' }) %>

<%# «Сними под этот трек»: звук там, где снимают вертикальные видео, и шаблон
    монтажа. Ссылки на площадки те же, что и для прослушивания, — в редакторах
    VK Клипов и Reels трек ищут по названию, поэтому его показываем текстом. %>
<section class="link-section shoot-block">
  <h2>Снять видео под этот трек</h2>
  <p class="shoot-name">Ищите в редакторе по названию: <strong><%= track.title %></strong> — DJ Levka</p>
  <% if (shootLinks.length) { %>
    <div class="platform-links">
      <% shootLinks.forEach(function (b, i) { %>
        <a class="btn <%= i ? 'btn-ghost' : '' %> platform-link" href="<%= b.url %>" target="_blank" rel="noopener"><%= b.label %></a>
      <% }); %>
    </div>
  <% } %>
  <% if (templateUrl) { %>
    <p class="shoot-template"><a class="btn btn-ghost" href="<%= templateUrl %>" target="_blank" rel="noopener">Открыть шаблон монтажа</a></p>
  <% } %>
  <p class="track-links-hint">
    Сняли — присылайте в <a href="/contest">конкурс</a>: за проход под трек разыгрываем съёмку в клипе.
    Трек можно использовать в своих роликах свободно, с указанием DJ Levka.
  </p>
</section>

<nav class="track-pager">
  <% if (prevTrack) { %>
    <a class="track-pager-link" href="/music/<%= release.slug %>/<%= prevTrack.slug %>">← <%= prevTrack.title %></a>
  <% } else { %><span></span><% } %>
  <a class="track-pager-link track-pager-up" href="/music/<%= release.slug %>">Все треки <%= release.title %></a>
  <% if (nextTrack) { %>
    <a class="track-pager-link" href="/music/<%= release.slug %>/<%= nextTrack.slug %>"><%= nextTrack.title %> →</a>
  <% } else { %><span></span><% } %>
</nav>

<%- include('partials/music-strip') %>

<%- include('partials/share') %>

<% if (track.audio) { %>
<script>
  // Пришли по клику на трек из списка релиза (?play=1): включаем сразу, а
  // фоновую музыку глушим. Если браузер запретил автозапуск, плеер остаётся
  // на месте и ждёт нажатия — ничего не ломается.
  (function () {
    if (!/[?&]play=1/.test(location.search)) return;
    var player = document.querySelector('.track-player');
    if (!player) return;
    var bg = document.getElementById('bg-audio');
    var toggle = document.getElementById('bg-audio-toggle');
    if (bg && !bg.paused && toggle) toggle.click();
    var p = player.play();
    if (p && p.catch) p.catch(function () {});
    if (history.replaceState) history.replaceState(null, '', location.pathname);
  })();
</script>
<% } %>

<%- include('partials/footer') %>
