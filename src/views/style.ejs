<%- include('partials/header') %>

<section class="hero">
  <h1>Стиль</h1>
  <% if (intro) { %><p class="hero-tagline"><%- renderLinkedText(intro) %></p><% } %>
</section>

<% banners.forEach(function(banner) { %>
  <%- include('partials/banner', { banner }) %>
<% }); %>

<%- include('partials/gallery-section', { galleryItems: galleryItems, galleryTitle: 'Образы' }) %>

<% groups.forEach(function(group) { %>
  <section class="link-section">
    <% if (group.name) { %><h2><%= group.name %></h2><% } %>
    <div class="link-grid">
      <% group.items.forEach(function(link) { %>
        <a class="link-card" href="<%= link.url %>" target="_blank" rel="noopener"><%= link.label %></a>
      <% }); %>
    </div>
  </section>
<% }); %>

<%- include('partials/footer') %>
