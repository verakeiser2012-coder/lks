<%- include('partials/header') %>

<section class="hero">
  <h1>Стиль</h1>
  <% if (intro) { %><p class="hero-tagline"><%- renderLinkedText(intro) %></p><% } %>
</section>

<% banners.forEach(function(banner) { %>
  <%- include('partials/banner', { banner }) %>
<% }); %>

<%- include('partials/chapter-index', { chapterIndex: [
  { num: '01', title: 'Вдохновительный лев', href: '#portfolio' },
  { num: '02', title: 'Проходка', href: '#walks' },
  { num: '03', title: 'Рыжий', href: '#redhead' },
] }) %>

<%# 01 Вдохновительный лев: портфолио, образы и то, что вдохновляет — один раздел.
    Сюда отправляем кастинги и бренды: кадры, факты, куда писать. Параметры
    не публикуем, отдаём по запросу — так принято у детских агентств. %>
<section class="chapter" id="portfolio">
  <header class="chapter-head">
    <span class="chapter-num">01</span>
    <h2 class="chapter-title">Вдохновительный лев</h2>
    <a class="chapter-more" href="/brands/media-kit">Медиакит для брендов →</a>
  </header>
  <p class="chapter-deck"><%= texts.portfolio || 'В кадре с четырёх лет: реклама, кино, показы. Работаем по договору с законным представителем.' %></p>
  <% var portfolioShots = portfolio.filter(function (i) { return i.type === 'photo'; }); %>
  <% if (portfolioShots.length) { %>
    <div class="portfolio-grid">
      <% portfolioShots.forEach(function(item) { %>
        <img src="<%= thumb(item.file_path, 480) %>" alt="<%= item.title %>" title="<%= item.title %>" loading="lazy">
      <% }); %>
    </div>
  <% } %>
  <ul class="portfolio-facts">
    <li><strong>В кадре</strong>с четырёх лет</li>
    <li><strong>Снимаюсь</strong>реклама, кино, показы, каталоги</li>
    <li><strong>Волосы</strong>натуральный рыжий</li>
    <li><strong>Город</strong>Екатеринбург, выезд по договорённости</li>
    <li><strong>Параметры</strong>актуальные — по запросу</li>
  </ul>
  <div class="portfolio-actions">
    <a class="btn btn-ghost" href="/podcast#film">Видео и бэкстейдж — в разделе «В кадре»</a>
  </div>

<%# Образы. Не витрина, а вопрос посетителю: какой образ снимать следующим.
    Голос — один с устройства на образ, счётчик виден всем. %>
<div class="chapter-sub" id="looks">
  <h3 class="chapter-subtitle">Образы</h3>
  <p class="chapter-deck"><%= texts.looks || 'Какой образ снимать следующим? Отметьте: один голос с устройства на образ, итог виден всем.' %></p>
  <% if (looks.length === 0) { %>
    <p class="hint">Кадры появятся здесь после первой съёмки для раздела.</p>
  <% } else { %>
    <div class="looks-grid">
      <% looks.forEach(function(item, i) { %>
        <figure class="look polaroid polaroid-<%= i % 3 %>" data-look-id="<%= item.id %>">
          <% if (item.type === 'photo') { %>
            <img src="<%= thumb(item.file_path, 640) %>" srcset="<%= srcset(item.file_path) %>" sizes="(max-width: 640px) 46vw, 260px" alt="<%= item.title %>" loading="lazy">
          <% } else { %>
            <video src="<%= item.file_path %>" muted loop playsinline preload="metadata"></video>
          <% } %>
          <figcaption class="look-caption">
            <span class="look-title"><%= item.title %></span>
            <button type="button" class="look-vote" aria-pressed="false" aria-label="На следующую съёмку">
              <span class="look-vote-mark" aria-hidden="true">✦</span>
              <span class="look-vote-count"><%= item.votes %></span>
            </button>
          </figcaption>
        </figure>
      <% }); %>
    </div>
  <% } %>
</div>

<div class="chapter-sub" id="inspires">
  <h3 class="chapter-subtitle">Что вдохновляет</h3>
  <p class="chapter-deck"><%= texts.inspires || 'Съёмки, которые запомнились: самая первая, самая длинная, самая ранняя. Подпись под каждым кадром — про то, чем он дорог.' %></p>
  <% if (inspireItems.length) { %>
    <%- include('partials/gallery-section', { galleryItems: inspireItems, galleryTitle: '' }) %>
  <% } else { %>
    <p class="hint">Подборка собирается: кадры и ролики с подписями появятся здесь.</p>
  <% } %>
</div>
</section>

<%# 02 Проходка. Подиум по годам, и игра: год спрятан, посетитель угадывает. %>
<section class="chapter" id="walks">
  <header class="chapter-head">
    <span class="chapter-num">02</span>
    <h2 class="chapter-title">Проходка</h2>
    <a class="chapter-more" href="/contest">Твой выход под трек →</a>
  </header>
  <p class="chapter-deck"><%= texts.walks || 'Подиум с четырёх лет до сейчас. Год не подписан: угадайте его по ролику.' %></p>
  <% if (walks.length === 0) { %>
    <p class="hint">Ролики с подиума появятся здесь по одному на год.</p>
  <% } else { %>
    <div class="walks-game" data-years="<%= years.join(',') %>">
      <div class="filmstrip"><div class="filmstrip-track">
        <% walks.forEach(function(item, idx) {
          var isEmbed = item.type === 'video' && item.file_path.indexOf('http') === 0;
        %>
          <div class="film-cell" data-code="LEVKEYSER · ПОДИУМ" data-num="ВЫХОД <%= String(idx + 1).padStart(2, '0') %>">
            <div class="gallery-item edge-soft walk <%= item.type === 'video' && !isEmbed ? 'is-video' : '' %> <%= isEmbed ? 'is-embed' : '' %>" data-year="<%= item.year %>">
              <% if (item.type === 'photo') { %>
                <img src="<%= thumb(item.file_path, 640) %>" alt="<%= item.title %>" loading="lazy">
              <% } else if (isEmbed) { %>
                <div class="gallery-embed-frame"><iframe src="<%= item.file_path %>" loading="lazy" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen frameborder="0"></iframe></div>
              <% } else { %>
                <video src="<%= item.file_path %>" muted loop playsinline preload="metadata"></video>
              <% } %>
              <% if (item.year) { %>
                <div class="walk-guess">
                  <span class="walk-guess-q">Какой год?</span>
                  <div class="walk-guess-options"></div>
                  <span class="walk-guess-answer" hidden></span>
                </div>
              <% } else if (item.title) { %>
                <div class="gallery-caption"><%= item.title %></div>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div></div>
      <p class="walks-score" hidden>Угадано <strong class="walks-score-hit">0</strong> из <span class="walks-score-total">0</span>. <span class="walks-score-note"></span></p>
    </div>
  <% } %>
</section>



<%# 03 Рыжий. Только дверь в раздел, сам раздел живёт отдельно. %>
<section class="chapter chapter--tight" id="redhead">
  <header class="chapter-head">
    <span class="chapter-num">03</span>
    <h2 class="chapter-title">Рыжий</h2>
    <a class="chapter-more" href="/redheads">Рыжие, которые вдохновляют →</a>
  </header>
  <p class="chapter-deck"><%- renderLinkedText(texts.redhead || 'Цвет волос у 1–2% людей на планете. Я не крашу и не прячу: это часть стиля, а не особенность. Тут же собираю рыжих, на которых смотрю сам.') %></p>
</section>

<section class="chapter chapter--tight" id="brands-line">
  <p class="style-brands-line">Снимаюсь для брендов, работаем по договору. <a href="/brands/media-kit">Медиакит и форматы →</a></p>
</section>

<% if (groups.some(function(g) { return g.items.length > 0; })) { %>
  <section class="link-section">
    <% groups.forEach(function(group) { %>
      <% if (group.items.length === 0) return; %>
      <h2><%= group.name || 'Архив' %></h2>
      <div class="link-grid">
        <% group.items.forEach(function(link) { %>
          <a class="link-card" href="<%= link.url %>" target="_blank" rel="noopener"><%= link.label %></a>
        <% }); %>
      </div>
    <% }); %>
  </section>
<% } %>

<script src="/js/style-page.js" defer></script>
<%- include('partials/footer') %>
