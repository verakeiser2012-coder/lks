<%- include('partials/header') %>

<section class="hero">
  <h1>Рыжие, которые вдохновляют</h1>
  <% if (intro) { %><p class="hero-tagline"><%- renderLinkedText(intro) %></p><% } %>
</section>

<% (banners || []).forEach(function(banner) { %><%- include('partials/banner', { banner }) %><% }); %>

<% if (typeof reads !== 'undefined' && reads.length) { %>
  <p class="redhead-reads">Откуда раздел:
    <% reads.forEach(function(r, i) { %><%= i ? ' · ' : '' %><a href="/diary/<%= r.slug %>"><%= r.title %></a><% }); %>
  </p>
<% } %>

<% if (people.length === 0) { %>
  <p>Подборка скоро появится.</p>
<% } else { %>
  <div class="spotlight-grid">
    <% people.forEach(function(person) { %>
      <div class="spotlight-card">
        <% if (person.photo) { %>
          <img loading="lazy" decoding="async" class="spotlight-photo" src="<%= thumb(person.photo, 640) %>" srcset="<%= srcset(person.photo) %>" sizes="(max-width: 640px) 92vw, 300px" alt="<%= person.name %>">
        <% } else { %>
          <div class="spotlight-photo spotlight-initial" aria-hidden="true"><%= person.name.trim().charAt(0) %></div>
        <% } %>
        <div class="spotlight-body">
          <%# Несовершеннолетние (18.09): только имя без фамилии, ссылок на соцсети нет. %>
          <div class="spotlight-name"><%= person.is_minor ? String(person.name).trim().split(/\s+/)[0] : person.name %></div>
          <% if (person.role) { %><div class="spotlight-role"><%= person.role %></div><% } %>
          <% if (person.note) { %><p class="spotlight-note"><%= person.note %></p><% } %>
          <% if (person.photo && person.photo_credit) { %><p class="spotlight-credit"><%- person.photo_credit %></p><% } %>
          <% if (person.link_url && !person.is_minor) { %>
            <a class="spotlight-link" href="<%= person.link_url %>" target="_blank" rel="noopener">
              <%= person.link_label || 'Смотреть' %> →
            </a>
          <% } %>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<section class="link-section redhead-apply">
  <h2>Хотите, чтобы вас заметили?</h2>
  <p style="color:var(--color-muted); max-width:60ch;">
    Открытой регистрации нет — подборку курирует команда сайта. Одно условие без исключений: рыжий цвет
    должен быть своим, не из краски. Оставьте о себе пару слов и ссылку на свою работу, мы посмотрим и,
    если подходит, добавим в подборку сами. Из этой подборки мы также предлагаем людей
    брендам для съёмок и рекламных кампаний — попадание в неё может стать не просто витриной, а реальным
    приглашением на проект.
  </p>
  <p style="color:var(--color-muted); max-width:60ch;">
    Возраст не ограничен. Если вам от 14 до 17 — заявку подаёте сами, а согласие подтверждает родитель
    по ссылке из письма. За детей до 14 лет заявку подаёт родитель или законный представитель.
    Несовершеннолетних мы показываем только по имени, без фамилии и без ссылок, а предложения брендов
    передаём через родителя.
  </p>
  <% if (submitted === 'teen') { %>
    <div class="flash flash-success">Спасибо! Заявка записана, а родителю ушло письмо со ссылкой для подтверждения. Как только он подтвердит — мы её рассмотрим.</div>
  <% } else if (submitted) { %>
    <div class="flash flash-success">Спасибо! Заявка отправлена, мы её рассмотрим.</div>
  <% } %>
  <% if (error) { %>
    <div class="flash flash-error"><%= error %></div>
  <% } %>
  <% const age = values.age || 'adult'; %>
  <form action="/redheads/submit" method="POST" style="max-width:480px;" id="submit" data-age-form>
  <input type="text" name="website" value="" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;" aria-hidden="true">
    <%# Кто подаёт заявку — от этого зависит, чьё согласие нужно и кому писать (18.09). %>
    <fieldset class="age-field">
      <legend>Кто подаёт заявку *</legend>
      <label class="age-option"><input type="radio" name="age" value="adult" <%= age === 'adult' ? 'checked' : '' %>> <span>Мне есть 18 лет</span></label>
      <label class="age-option"><input type="radio" name="age" value="teen" <%= age === 'teen' ? 'checked' : '' %>> <span>Мне от 14 до 17 лет — согласие подтвердит родитель по почте</span></label>
      <label class="age-option"><input type="radio" name="age" value="child" <%= age === 'child' ? 'checked' : '' %>> <span>Я родитель или законный представитель, ребёнку меньше 14</span></label>
    </fieldset>
    <label>
      <span data-age-label data-adult="Имя *" data-teen="Ваше имя *" data-child="Имя ребёнка *">Имя *</span>
      <input type="text" name="name" value="<%= values.name || '' %>" required>
    </label>
    <label>
      Род деятельности
      <input type="text" name="role" value="<%= values.role || '' %>" placeholder="Модель, музыкант...">
    </label>
    <label>
      Пара слов о себе
      <textarea name="note" rows="3"><%= values.note || '' %></textarea>
    </label>
    <label>
      Ссылка на работу/соцсеть
      <input type="url" name="linkUrl" value="<%= values.linkUrl || '' %>" placeholder="https://...">
    </label>
    <label>
      <span data-age-label data-adult="Контакт для связи (почта или телеграм) *" data-teen="Ваш контакт (почта или телеграм) *" data-child="Ваш контакт как родителя (почта или телеграм) *">Контакт для связи (почта или телеграм) *</span>
      <input type="text" name="contact" value="<%= values.contact || '' %>" required>
    </label>
    <div class="guardian-fields" data-guardian <%= age === 'adult' ? 'hidden' : '' %>>
      <label>
        <span data-age-label data-teen="Имя родителя или законного представителя *" data-child="Ваше имя (родителя) *">Имя родителя или законного представителя *</span>
        <input type="text" name="guardianName" value="<%= values.guardianName || '' %>">
      </label>
      <label>
        <span data-age-label data-teen="Почта родителя — туда придёт ссылка для подтверждения *" data-child="Ваша почта *">Почта родителя *</span>
        <input type="email" name="guardianContact" value="<%= values.guardianContact || '' %>" placeholder="name@example.com">
      </label>
    </div>
    <label style="display:flex; align-items:flex-start; gap:8px;">
      <input type="checkbox" name="dataConsent" value="1" style="width:auto; margin-top:4px;" <%= values.dataConsent ? 'checked' : '' %> required>
      <span data-age-label
            data-adult="Даю согласие на обработку персональных данных и публикацию фото и имени в подборке в соответствии с политикой конфиденциальности *"
            data-teen="Даю согласие на обработку моих данных в соответствии с политикой конфиденциальности; публикацию фото и имени отдельно подтвердит родитель *"
            data-child="Как законный представитель даю согласие на обработку данных ребёнка и публикацию его фото и имени в подборке в соответствии с политикой конфиденциальности *"
      >Даю согласие на обработку персональных данных и публикацию фото и имени в подборке в соответствии с
      <a href="/legal/privacy" target="_blank" rel="noopener">политикой конфиденциальности</a> *</span>
    </label>
    <button class="btn" type="submit">Отправить заявку</button>
  </form>
  <script src="/js/age-form.js?v=<%= assetVer %>" defer></script>
</section>

<%- include('partials/footer') %>
