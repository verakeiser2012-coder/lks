<%- include('partials/header') %>

<h1>Мои заказы</h1>

<% if (sent) { %>
  <div class="flash flash-success contact-sent">
    <strong>Если на <%= email %> оформлялись заказы, письмо со ссылками уже ушло.</strong>
    Обычно приходит за минуту; если нет — проверьте «Спам».
  </div>
  <p><a href="/catalog">← В каталог</a></p>
<% } else { %>
  <p class="contact-intro">
    Кабинета с паролем здесь нет. Введите почту, на которую оформляли заказ, —
    пришлём письмо со ссылками на все ваши заказы: статус, доставка, файлы.
  </p>

  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>

  <form class="contact-form" action="/orders" method="POST">
    <label>
      Почта <span class="req">*</span>
      <input type="email" name="email" value="<%= email %>" maxlength="200" required autocomplete="email">
    </label>
    <div class="hp" aria-hidden="true">
      <label>Не заполняйте это поле<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
    </div>
    <button class="btn" type="submit">Прислать ссылки</button>
  </form>
<% } %>

<%- include('partials/footer') %>
