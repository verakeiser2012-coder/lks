<%- include('partials/header') %>

<h1>Мой кабинет</h1>

<% if (sent) { %>
  <div class="flash flash-success contact-sent">
    <strong>Письмо со ссылкой ушло на <%= email %>.</strong>
    Обычно приходит за минуту; если нет — проверьте «Спам». Ссылка действует 30 дней.
  </div>
  <p><a href="/catalog">← В каталог</a> · <a href="/aroma">Карта ароматов</a></p>
<% } else { %>
  <p class="contact-intro">
    Кабинета с паролем здесь нет — и не будет. Введите почту, и мы пришлём ссылку: по ней открываются
    ваши заказы и файлы, нумерованные экземпляры, рецепты с карты ароматов и подписка на новости.
    Ссылка запоминается в браузере на 30 дней.
  </p>
  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
  <form class="contact-form" action="/my" method="POST">
    <input type="hidden" name="to" value="<%= to %>">
    <label>
      Почта <span class="req">*</span>
      <input type="email" name="email" value="<%= email %>" maxlength="200" required autocomplete="email">
    </label>
    <div class="hp" aria-hidden="true">
      <label>Не заполняйте это поле<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
    </div>
    <button class="btn" type="submit">Прислать ссылку</button>
  </form>
<% } %>

<%- include('partials/footer') %>
