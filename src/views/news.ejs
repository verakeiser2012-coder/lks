<%- include('partials/header') %>

<div class="admin-toolbar">
  <h1><%= lang === 'en' ? 'News' : 'Новости' %></h1>
  <% if (lang === 'en') { %>
    <a href="/news">На русском</a>
  <% } else { %>
    <a href="/en/news">English version</a>
  <% } %>
</div>

<% banners.forEach(function(banner) { %>
  <%- include('partials/banner', { banner }) %>
<% }); %>

<% if (posts.length === 0) { %>
  <p>Пока новостей нет.</p>
<% } else { %>
  <div class="news-list">
    <% posts.forEach(function(post) { %>
      <a class="news-card" href="<%= lang === 'en' ? '/en/news/' : '/news/' %><%= post.slug %>">
        <div class="news-card-image">
          <% if (coverByNewsId[post.id]) { %>
            <img src="<%= coverByNewsId[post.id] %>" alt="<%= post.title %>">
          <% } else { %>
            <div class="no-image">Нет фото</div>
          <% } %>
        </div>
        <div>
          <div class="news-date"><%= post.created_at %></div>
          <div class="news-title"><%= post.title %></div>
        </div>
      </a>
    <% }); %>
  </div>
<% } %>

<%- include('partials/footer') %>
