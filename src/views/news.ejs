<%- include('partials/header') %>

<div class="admin-toolbar">
  <h1><%= lang === 'en' ? 'News' : 'Новости' %></h1>
  <% if (lang === 'en') { %>
    <a href="/news">На русском</a>
  <% } else { %>
    <a href="/en/news">English version</a>
  <% } %>
</div>

<% banners.forEach(function(banner) { %>
  <%- include('partials/banner', { banner }) %>
<% }); %>

<% if (posts.length === 0) { %>
  <p>Пока новостей нет.</p>
<% } else { %>
  <div class="news-view-toggle">
    <button type="button" id="view-grid" class="active"><%= lang === 'en' ? 'Grid' : 'Плитка' %></button>
    <button type="button" id="view-rows"><%= lang === 'en' ? 'List' : 'Список' %></button>
  </div>
  <div class="news-list" id="news-list">
    <% posts.forEach(function(post) { %>
      <a class="news-card" href="<%= lang === 'en' ? '/en/news/' : '/news/' %><%= post.slug %>">
        <div class="news-card-image">
          <% if (coverByNewsId[post.id]) { %>
            <img src="<%= coverByNewsId[post.id] %>" alt="<%= post.title %>">
          <% } else { %>
            <div class="no-image">Нет фото</div>
          <% } %>
        </div>
        <div>
          <div class="news-date"><%= formatDate(post.created_at, lang) %></div>
          <div class="news-title"><% if (post.is_pinned) { %><span class="news-pin">📌</span> <% } %><%= post.title %></div>
        </div>
      </a>
    <% }); %>
  </div>
<% } %>

<script>
  (function () {
    var list = document.getElementById('news-list');
    var btnGrid = document.getElementById('view-grid');
    var btnRows = document.getElementById('view-rows');
    if (!list) return;
    function apply(view) {
      list.classList.toggle('news-list--rows', view === 'rows');
      btnGrid.classList.toggle('active', view !== 'rows');
      btnRows.classList.toggle('active', view === 'rows');
      try { localStorage.setItem('newsView', view); } catch (e) {}
    }
    btnGrid.addEventListener('click', function () { apply('grid'); });
    btnRows.addEventListener('click', function () { apply('rows'); });
    var saved = null;
    try { saved = localStorage.getItem('newsView'); } catch (e) {}
    if (saved === 'rows') apply('rows');
  })();
</script>

<%- include('partials/footer') %>
