<%- include('partials/header') %>

<h1>Отзыв</h1>

<% if (sent) { %>
  <div class="flash flash-success contact-sent">
    <strong>Спасибо! Отзыв получен.</strong>
    Появится на сайте после проверки — обычно в течение дня.
  </div>
  <p><a href="<%= back %>">← Назад</a></p>
<% } else { %>
  <% const openItems = items.filter(function (i) { return !i.reviewed; }); %>
  <% if (!openItems.length) { %>
    <p class="contact-intro">По этому заказу отзывы уже оставлены — спасибо!</p>
    <p><a href="<%= back %>">← Назад к заказу</a></p>
  <% } else { %>
  <p class="contact-intro">
    <%= kind === 'service' ? 'Пара слов о том, как прошла работа: что помогло, что можно сделать лучше.' : 'Пара слов о вещи: как выглядит вживую, как доехала, что бы улучшить.' %>
    Отзыв подписывается именем, почта и номер заказа не публикуются.
  </p>

  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>

  <form class="contact-form" action="<%= action %>" method="POST">
    <% if (openItems.length === 1) { %>
      <input type="hidden" name="product_id" value="<%= openItems[0].product_id %>">
      <p><strong><%= openItems[0].product_name %></strong></p>
    <% } else { %>
      <label>
        О чём отзыв <span class="req">*</span>
        <select name="product_id" required>
          <option value="">— выберите —</option>
          <% openItems.forEach(function (i) { %><option value="<%= i.product_id %>" <%= String(form.product_id) === String(i.product_id) ? 'selected' : '' %>><%= i.product_name %></option><% }); %>
        </select>
      </label>
    <% } %>

    <fieldset class="rating-field">
      <legend>Оценка <span class="req">*</span></legend>
      <div class="rating-stars">
        <% [5, 4, 3, 2, 1].forEach(function (n) { %>
          <input type="radio" id="r<%= n %>" name="rating" value="<%= n %>" <%= String(form.rating) === String(n) ? 'checked' : '' %> required><label for="r<%= n %>" title="<%= n %>">★</label>
        <% }); %>
      </div>
    </fieldset>

    <label>
      Как вас подписать <span class="req">*</span>
      <input type="text" name="name" value="<%= form.name !== undefined ? form.name : name %>" maxlength="80" required>
    </label>

    <label>
      Отзыв <span class="req">*</span>
      <textarea name="body" rows="6" maxlength="3000" required><%= form.body || '' %></textarea>
    </label>

    <div class="hp" aria-hidden="true">
      <label>Не заполняйте это поле<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
    </div>

    <button class="btn" type="submit">Отправить отзыв</button>
  </form>
  <% } %>
<% } %>

<%- include('partials/footer') %>
