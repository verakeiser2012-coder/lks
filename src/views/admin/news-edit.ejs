<%- include('partials/header') %>

<%
  const twinPost = typeof twin !== 'undefined' ? twin : null;
  const flashMsg = typeof msg !== 'undefined' ? msg : '';
  const otherLangName = post.lang === 'en' ? 'русскую' : 'английскую';
%>
<div class="admin-toolbar">
  <h1>Редактировать новость <span class="badge"><%= post.lang === 'en' ? 'EN' : 'RU' %></span></h1>
  <div>
    <% if (twinPost) { %>
      <a class="btn" href="/admin/news/<%= twinPost.id %>/edit">К <%= post.lang === 'en' ? 'русской' : 'английской' %> версии<%= twinPost.is_published ? '' : ' (черновик)' %></a>
    <% } else { %>
      <form class="inline" action="/admin/news/<%= post.id %>/translate" method="POST" onsubmit="this.querySelector('button').disabled = true; this.querySelector('button').textContent = 'Перевожу…';">
        <button class="btn" type="submit">Создать <%= otherLangName %> версию (автоперевод)</button>
      </form>
    <% } %>
    &nbsp;
    <a class="btn" href="/admin/calendar/new?fromNews=<%= post.id %>">Создать пост в календаре</a>
  </div>
</div>

<% if (error) { %>
  <div class="flash flash-error"><%= error %></div>
<% } %>
<% if (flashMsg) { %>
  <div class="flash"><%= flashMsg %></div>
<% } %>

<form action="/admin/news/<%= post.id %>" method="POST">
  <label>
    Заголовок *
    <input type="text" name="title" id="news-title" value="<%= post.title %>" required>
  </label>
  <label>
    Текст
    <textarea name="content" id="news-content" rows="8"><%= post.content %></textarea>
  </label>
  <div class="translate-row">
    <button type="button" class="btn translate-btn" data-translate-from="#news-title,#news-content" data-translate-to="#news-title,#news-content" data-translate-then-select="select[name=lang]" data-translate-then-value="en">Перевести заголовок и текст на английский (заменит поля, язык станет EN)</button>
  </div>
  <p class="flash">Чтобы вставить ссылку в текст, используйте формат: <code>[текст ссылки](https://...)</code> — работает и с внутренними ссылками вида <code>/news/...</code></p>
  <label>
    Язык
    <select name="lang">
      <option value="ru" <%= post.lang === 'ru' ? 'selected' : '' %>>Русский (/news)</option>
      <option value="en" <%= post.lang === 'en' ? 'selected' : '' %>>English (/en/news)</option>
    </select>
  </label>
  <label>
    <input type="checkbox" name="isPublished" value="1" style="width:auto;display:inline-block;" <%= post.is_published ? 'checked' : '' %>>
    Опубликовать
  </label>
  <button class="btn" type="submit">Сохранить</button>
</form>

<h2>Фото и видео</h2>

<form action="/admin/news/<%= post.id %>/media" method="POST" enctype="multipart/form-data" class="gallery-upload-form">
  <label>
    Тип
    <select name="type" required>
      <option value="photo">Фото</option>
      <option value="video">Видео</option>
    </select>
  </label>
  <label>
    Порядок сортировки
    <input type="number" name="sortOrder" value="0">
  </label>
  <label>
    Файл *
    <input type="file" name="file" accept="image/*,video/*" required>
  </label>
  <button class="btn" type="submit">Загрузить</button>
</form>

<div class="admin-media-grid">
  <% media.forEach(function(item) { %>
    <div class="admin-media-item">
      <% if (item.type === 'photo') { %>
        <img src="<%= item.file_path %>" alt="">
      <% } else { %>
        <video src="<%= item.file_path %>" controls></video>
      <% } %>
      <form action="/admin/news/<%= post.id %>/media/<%= item.id %>/delete" method="POST" onsubmit="return confirm('Удалить файл?');">
        <button class="link-btn" type="submit">Удалить</button>
      </form>
    </div>
  <% }); %>
</div>

<p><a href="/admin/news">← Ко всем новостям</a></p>

<script src="/js/admin-translate.js?v=<%= assetVer %>"></script>

<%- include('partials/footer') %>
