<%- include('partials/header') %>

<h1><%= product && product.id ? 'Редактировать товар' : 'Новый товар' %></h1>

<% if (error) { %>
  <div class="flash flash-error"><%= error %></div>
<% } %>

<form
  action="<%= product && product.id ? `/admin/products/${product.id}` : '/admin/products' %>"
  method="POST"
  enctype="multipart/form-data"
>
  <label>
    Название *
    <input type="text" name="name" value="<%= product ? product.name : '' %>" required>
  </label>
  <label>
    Описание
    <textarea name="description" rows="4"><%= product ? product.description : '' %></textarea>
  </label>
  <label>
    Цена *
    <input type="number" step="0.01" name="price" value="<%= product ? product.price : '' %>" required>
  </label>
  <label>
    Остаток на складе
    <input type="number" name="stock" value="<%= product ? product.stock : 0 %>">
  </label>

  <fieldset style="border:1px solid #ddd; border-radius:8px; padding:12px 14px; margin:0 0 16px;">
    <legend style="padding:0 6px;">Цифровой товар</legend>
    <label>
      <input type="checkbox" name="isDigital" value="1" id="is-digital" style="width:auto;display:inline-block;"
        <%= product && product.is_digital ? 'checked' : '' %>>
      Это файл, а не физический товар
    </label>
    <p style="color:#666; font-size:0.85rem; margin:4px 0 12px;">
      DJ-версии, стемы, пресеты. Остаток и доставка не спрашиваются, количество всегда одно.
      После оплаты покупателю уходит ссылка на скачивание — она живёт 30 дней и работает 5 раз.
    </p>
    <label>
      Файл товара
      <input type="file" name="digitalFile" accept=".mp3,.wav,.flac,.aiff,.aif,.zip">
    </label>
    <p style="color:#666; font-size:0.85rem; margin:-8px 0 8px;">
      mp3, wav, flac, aiff или zip, до 500 МБ. Файл лежит в закрытой папке и по прямой ссылке недоступен.
    </p>
    <% if (product && product.digital_filename) { %>
      <p style="font-size:0.9rem;">
        Загружен: <strong><%= product.digital_filename %></strong>
        <% if (product.digital_size) { %>
          (<%= (product.digital_size / (1024 * 1024)).toFixed(1) %> МБ)
        <% } %>
        — новый файл заменит текущий.
      </p>
    <% } %>
  </fieldset>
  <label>
    Категория
    <select name="categoryId">
      <option value="">— без категории —</option>
      <% categories.forEach(function(cat) { %>
        <option value="<%= cat.id %>" <%= product && Number(product.category_id) === cat.id ? 'selected' : '' %>>
          <%= cat.name %>
        </option>
      <% }); %>
    </select>
  </label>
  <label>
    Или новая категория
    <input type="text" name="newCategory" placeholder="Название новой категории">
  </label>
  <label>
    Дроп
    <select name="collectionId">
      <option value="">— без дропа —</option>
      <% collections.forEach(function(c) { %>
        <option value="<%= c.id %>" <%= product && Number(product.collection_id) === c.id ? 'selected' : '' %>>
          <%= c.name %>
        </option>
      <% }); %>
    </select>
  </label>
  <label>
    Релиз (EP)
    <select name="releaseId">
      <option value="">— без привязки —</option>
      <% releases.forEach(function(r) { %>
        <option value="<%= r.id %>" <%= product && Number(product.release_id) === r.id ? 'selected' : '' %>>
          <%= r.title %> (<%= r.year %>)
        </option>
      <% }); %>
    </select>
  </label>
  <fieldset style="border:1px solid var(--color-border); border-radius:var(--radius); padding:12px 14px; margin:0 0 16px;">
    <legend style="padding:0 6px;">Параметры для карточки</legend>
    <p style="color:var(--color-muted); font-size:0.85rem; margin-top:0;">
      Покупатель должен видеть, что именно получит, до оформления заказа.
      Пустые поля в карточке не показываются.
    </p>
    <label>
      Срок изготовления
      <input type="text" name="leadTime" value="<%= product && product.lead_time ? product.lead_time : '' %>"
             placeholder="например: 7–10 дней — гипсу нужно высохнуть">
    </label>
    <label>
      Что входит
      <textarea name="includes" rows="2" placeholder="каждый пункт с новой строки"><%= product && product.includes ? product.includes : '' %></textarea>
    </label>
    <label>
      Размер
      <input type="text" name="dimensions" value="<%= product && product.dimensions ? product.dimensions : '' %>" placeholder="например: 12 × 8 × 8 см">
    </label>
    <label>
      Вес
      <input type="text" name="weight" value="<%= product && product.weight ? product.weight : '' %>" placeholder="например: 150 г">
    </label>
    <label>
      Материал
      <input type="text" name="material" value="<%= product && product.material ? product.material : '' %>" placeholder="например: гипс">
    </label>
    <label>
      Уход и хранение
      <input type="text" name="care" value="<%= product && product.care ? product.care : '' %>" placeholder="например: беречь от влаги, протирать сухой тканью">
    </label>
  </fieldset>
  <label>
    Фото товара
    <input type="file" name="image" accept="image/*">
  </label>
  <% if (product && product.image) { %>
    <img src="<%= product.image %>" alt="" style="width:120px;border-radius:8px;margin-bottom:14px;">
  <% } %>
  <label>
    <input type="checkbox" name="isActive" value="1" style="width:auto;display:inline-block;"
      <%= !product || product.is_active ? 'checked' : '' %>>
    Показывать в каталоге
  </label>
  <button class="btn" type="submit">Сохранить</button>
</form>

<%- include('partials/footer') %>
