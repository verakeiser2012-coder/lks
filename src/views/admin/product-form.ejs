<%- include('partials/header') %>

<h1><%= product && product.id ? 'Редактировать товар' : 'Новый товар' %></h1>

<% if (error) { %>
  <div class="flash flash-error"><%= error %></div>
<% } %>

<form
  action="<%= product && product.id ? `/admin/products/${product.id}` : '/admin/products' %>"
  method="POST"
  enctype="multipart/form-data"
>
  <label>
    Название *
    <input type="text" name="name" value="<%= product ? product.name : '' %>" required>
  </label>
  <label>
    Описание
    <textarea name="description" rows="4"><%= product ? product.description : '' %></textarea>
  </label>
  <label>
    Цена *
    <input type="number" step="0.01" name="price" value="<%= product ? product.price : '' %>" required>
  </label>
  <label>
    Остаток на складе
    <input type="number" name="stock" value="<%= product ? product.stock : 0 %>">
  </label>
  <label>
    Категория
    <select name="categoryId">
      <option value="">— без категории —</option>
      <% categories.forEach(function(cat) { %>
        <option value="<%= cat.id %>" <%= product && Number(product.category_id) === cat.id ? 'selected' : '' %>>
          <%= cat.name %>
        </option>
      <% }); %>
    </select>
  </label>
  <label>
    Или новая категория
    <input type="text" name="newCategory" placeholder="Название новой категории">
  </label>
  <label>
    Дроп
    <select name="collectionId">
      <option value="">— без дропа —</option>
      <% collections.forEach(function(c) { %>
        <option value="<%= c.id %>" <%= product && Number(product.collection_id) === c.id ? 'selected' : '' %>>
          <%= c.name %>
        </option>
      <% }); %>
    </select>
  </label>
  <label>
    Релиз (EP)
    <select name="releaseId">
      <option value="">— без привязки —</option>
      <% releases.forEach(function(r) { %>
        <option value="<%= r.id %>" <%= product && Number(product.release_id) === r.id ? 'selected' : '' %>>
          <%= r.title %> (<%= r.year %>)
        </option>
      <% }); %>
    </select>
  </label>
  <label>
    Фото товара
    <input type="file" name="image" accept="image/*">
  </label>
  <% if (product && product.image) { %>
    <img src="<%= product.image %>" alt="" style="width:120px;border-radius:8px;margin-bottom:14px;">
  <% } %>
  <label>
    <input type="checkbox" name="isActive" value="1" style="width:auto;display:inline-block;"
      <%= !product || product.is_active ? 'checked' : '' %>>
    Показывать в каталоге
  </label>
  <button class="btn" type="submit">Сохранить</button>
</form>

<%- include('partials/footer') %>
