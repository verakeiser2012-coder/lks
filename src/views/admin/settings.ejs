<%- include('partials/header') %>

<h1>Настройки</h1>

<% if (saved) { %>
  <div class="flash flash-success">Сохранено.</div>
<% } %>

<form action="/admin/settings" method="POST">
  <label>
    Название / имя
    <input type="text" name="site_name" value="<%= settingsMap.site_name || '' %>">
  </label>
  <label>
    Второе имя (псевдоним, показывается рядом со значком в шапке)
    <input type="text" name="site_alt_name" value="<%= settingsMap.site_alt_name || '' %>">
  </label>
  <label>
    Слоган (подзаголовок под названием)
    <input type="text" name="site_tagline" value="<%= settingsMap.site_tagline || '' %>">
  </label>
  <label>
    Описание сайта для поиска и превью ссылок (150-200 символов)
    <textarea name="meta_description" rows="2"><%= settingsMap.meta_description || '' %></textarea>
  </label>
  <label>
    Картинка для превью ссылок (путь вида /uploads/og.jpg; пусто — возьмётся обложка последнего релиза)
    <input type="text" name="og_image" value="<%= settingsMap.og_image || '' %>">
  </label>
  <label>
    Номер счётчика Яндекс.Метрики (только цифры; пусто — счётчик не подключён)
    <input type="text" name="metrika_id" value="<%= settingsMap.metrika_id || '' %>">
  </label>
  <label>
    Телефон
    <input type="text" name="phone" value="<%= settingsMap.phone || '' %>">
  </label>
  <label>
    Email
    <input type="email" name="email" value="<%= settingsMap.email || '' %>">
  </label>
  <label>
    Адрес
    <input type="text" name="address" value="<%= settingsMap.address || '' %>">
  </label>
  <label>
    Ссылка VK
    <input type="url" name="vk_url" value="<%= settingsMap.vk_url || '' %>">
  </label>
  <label>
    Ссылка Telegram
    <input type="url" name="telegram_url" value="<%= settingsMap.telegram_url || '' %>">
  </label>
  <label>
    Ссылка WhatsApp
    <input type="url" name="whatsapp_url" value="<%= settingsMap.whatsapp_url || '' %>">
  </label>
  <label>
    Ссылка Instagram
    <input type="url" name="instagram_url" value="<%= settingsMap.instagram_url || '' %>">
  </label>
  <label>
    Ссылка YouTube
    <input type="url" name="youtube_url" value="<%= settingsMap.youtube_url || '' %>">
  </label>
  <label>
    Ссылка TikTok
    <input type="url" name="tiktok_url" value="<%= settingsMap.tiktok_url || '' %>">
  </label>
  <label>
    Ссылка Pinterest
    <input type="url" name="pinterest_url" value="<%= settingsMap.pinterest_url || '' %>">
  </label>
  <label>
    Ссылка Rutube
    <input type="url" name="rutube_url" value="<%= settingsMap.rutube_url || '' %>">
  </label>
  <label>
    Ссылка Одноклассники
    <input type="url" name="ok_url" value="<%= settingsMap.ok_url || '' %>">
  </label>
  <label>
    Ссылка Дзен
    <input type="url" name="dzen_url" value="<%= settingsMap.dzen_url || '' %>">
  </label>
  <label>
    Ссылка Douyin
    <input type="url" name="douyin_url" value="<%= settingsMap.douyin_url || '' %>">
  </label>
  <label>
    Ссылка Weibo
    <input type="url" name="weibo_url" value="<%= settingsMap.weibo_url || '' %>">
  </label>
  <label>
    Ссылка WeChat
    <input type="url" name="wechat_url" value="<%= settingsMap.wechat_url || '' %>">
  </label>
  <label>
    Ссылка Xiaohongshu
    <input type="url" name="xiaohongshu_url" value="<%= settingsMap.xiaohongshu_url || '' %>">
  </label>
  <h2>Юридическая информация (для оферты, политики конфиденциальности и т.д.)</h2>
  <p style="color:var(--color-muted); max-width:60ch;">
    Используется в текстах на страницах <code>/legal/oferta</code>, <code>/legal/privacy</code>,
    <code>/legal/delivery</code>, <code>/legal/returns</code>. Пока поля пустые, эти страницы
    показывают «реквизиты уточняются» вместо конкретных данных — заполните перед тем, как принимать
    настоящие платежи.
  </p>
  <label>
    ФИО индивидуального предпринимателя полностью
    <input type="text" name="legal_ip_name" value="<%= settingsMap.legal_ip_name || '' %>" placeholder="Иванов Иван Иванович">
  </label>
  <label>
    ИНН
    <input type="text" name="legal_inn" value="<%= settingsMap.legal_inn || '' %>">
  </label>
  <label>
    ОГРНИП
    <input type="text" name="legal_ogrnip" value="<%= settingsMap.legal_ogrnip || '' %>">
  </label>
  <label>
    Адрес для корреспонденции/претензий (необязательно, если решили не публиковать — оставьте пустым)
    <input type="text" name="legal_address" value="<%= settingsMap.legal_address || '' %>">
  </label>
  <label>
    Дата редакции документов (показывается внизу каждой юридической страницы)
    <input type="text" name="legal_doc_date" value="<%= settingsMap.legal_doc_date || '' %>" placeholder="17.08.2026">
  </label>
  <label>
    Банк
    <input type="text" name="legal_bank_name" value="<%= settingsMap.legal_bank_name || '' %>">
  </label>
  <label>
    Расчётный счёт
    <input type="text" name="legal_bank_account" value="<%= settingsMap.legal_bank_account || '' %>">
  </label>
  <label>
    БИК
    <input type="text" name="legal_bank_bik" value="<%= settingsMap.legal_bank_bik || '' %>">
  </label>
  <label>
    Корреспондентский счёт
    <input type="text" name="legal_bank_corr_account" value="<%= settingsMap.legal_bank_corr_account || '' %>">
  </label>

  <button class="btn" type="submit">Сохранить</button>
</form>

<%- include('partials/footer') %>
