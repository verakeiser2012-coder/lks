<%- include('partials/header') %>

<div class="admin-toolbar">
  <h1>Баннеры между страницами</h1>
  <a class="btn" href="/admin/banners/new">+ Новый баннер</a>
</div>
<p class="hint">Баннер — широкая полоса с заголовком, подписью и кнопкой. Ниже показано,
  на какой странице и в каком месте он появится. Мест семь, и каждое реально выводится:
  ключ, которого нет в списке, означает баннер, который нигде не покажется.</p>

<details class="hint">
  <summary>Где именно стоят места</summary>
  <ul>
    <% slots.forEach(function (s) { %>
      <li><strong><%= s.label %></strong> — <%= s.where %> <code><%= s.key %></code></li>
    <% }); %>
  </ul>
</details>

<table>
  <thead>
    <tr>
      <th>Страница</th>
      <th>Заголовок</th>
      <th>Ведёт на</th>
      <th>Опубликован</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% banners.forEach(function(b) { %>
      <tr>
        <td><%= slotLabel(b.page_key) %></td>
        <td><%= b.title %></td>
        <td><%= b.cta_url %></td>
        <td><%= b.is_published ? 'Да' : 'Нет' %></td>
        <td>
          <a href="/admin/banners/<%= b.id %>/edit">Изменить</a>
          <form class="inline" action="/admin/banners/<%= b.id %>/delete" method="POST" onsubmit="return confirm('Удалить баннер?');">
            <button class="link-btn" type="submit">Удалить</button>
          </form>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>

<%- include('partials/footer') %>
