<%- include('partials/header') %>

<div class="admin-toolbar">
  <h1>Баннеры между страницами</h1>
  <a class="btn" href="/admin/banners/new">+ Новый баннер</a>
</div>
<p class="hint">Страница (page_key) — куда выводится баннер: <code>home</code>, <code>style</code>, <code>music</code>,
  <code>video</code>, <code>gigs</code>, <code>news</code>, <code>gallery</code>, <code>about</code>, <code>drops</code>, <code>redheads</code>.</p>

<table>
  <thead>
    <tr>
      <th>Страница</th>
      <th>Заголовок</th>
      <th>Ведёт на</th>
      <th>Опубликован</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% banners.forEach(function(b) { %>
      <tr>
        <td><%= b.page_key %></td>
        <td><%= b.title %></td>
        <td><%= b.cta_url %></td>
        <td><%= b.is_published ? 'Да' : 'Нет' %></td>
        <td>
          <a href="/admin/banners/<%= b.id %>/edit">Изменить</a>
          <form class="inline" action="/admin/banners/<%= b.id %>/delete" method="POST" onsubmit="return confirm('Удалить баннер?');">
            <button class="link-btn" type="submit">Удалить</button>
          </form>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>

<%- include('partials/footer') %>
