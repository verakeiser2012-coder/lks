<%- include('partials/header') %>

<div class="admin-toolbar">
  <h1>Календарь публикаций</h1>
  <div>
    <a href="/admin/calendar/instagram-grid">Превью Instagram-сетки</a>
    &nbsp;&nbsp;
    <a class="btn" href="/admin/calendar/new">+ Запланировать пост</a>
  </div>
</div>

<div class="admin-toolbar">
  <a href="/admin/calendar?year=<%= prevYear %>&month=<%= prevMonth %>">← Пред. месяц</a>
  <% const monthNames = ['Январь', 'Февраль', 'Март', 'Апрель', 'Май', 'Июнь', 'Июль', 'Август', 'Сентябрь', 'Октябрь', 'Ноябрь', 'Декабрь']; %>
  <strong><%= monthNames[month - 1] %> <%= year %></strong>
  <a href="/admin/calendar?year=<%= nextYear %>&month=<%= nextMonth %>">След. месяц →</a>
</div>

<%
  const NET_SHORT = {
    telegram: 'TG', vk: 'VK', youtube: 'YT', instagram: 'IG', 'instagram-djlevka': 'IGm',
    tiktok: 'TT', news: 'Сайт', dzen: 'Дзен', rutube: 'RT', ok: 'ОК', pinterest: 'Pin',
    soundcloud: 'SC', vimeo: 'Vim', x: 'X', facebook: 'FB', yappy: 'Яp', likee: 'Lk',
  };
  function netShort(key) { return NET_SHORT[key] || key.slice(0, 3).toUpperCase(); }
%>

<%# Спонтанные публикации мимо календаря — репост в X, пост в Facebook,
    статья в Дзене. Раньше они нигде не отражались, и человек, открывший
    календарь, знал только про будущее: что уже вышло и что можно
    перепостить, видно не было. %>
<% if (typeof calendarError !== 'undefined' && calendarError) { %>
  <div class="flash flash-error"><%= calendarError %></div>
<% } %>

<section class="feed-log">
  <div class="feed-head">
    <h2>Уже в ленте</h2>
    <form class="feed-form" action="/admin/calendar/log" method="POST">
      <input type="url" name="url" placeholder="Ссылка на публикацию" required>
      <input type="text" name="text" placeholder="О чём — необязательно">
      <button class="btn" type="submit">Записать</button>
    </form>
  </div>
  <p class="feed-hint">Опубликовали руками — вставьте ссылку. Площадку и время определим сами.</p>

  <% if (!published || published.length === 0) { %>
    <p class="feed-empty">Пока ничего не записано.</p>
  <% } else { %>
    <ul class="feed-list">
      <% published.forEach(function (p) { %>
        <li class="feed-item">
          <div class="feed-when"><%= String(p.scheduled_at).slice(0, 16) %></div>
          <div class="feed-body">
            <a class="feed-text" href="/admin/calendar/<%= p.id %>"><%= String(p.text).split('\n')[0].slice(0, 90) %></a>
            <div class="feed-where">
              <% p.targets.forEach(function (t) { %>
                <% if (t.published_url) { %>
                  <a class="badge badge-published" href="<%= t.published_url %>" target="_blank" rel="noopener"><%= t.network_key %> ↗</a>
                <% } else { %>
                  <span class="badge badge-published"><%= t.network_key %></span>
                <% } %>
              <% }); %>
              <% if (p.missing.length > 0) { %>
                <span class="feed-missing">можно ещё:
                  <% p.missing.forEach(function (n, i) { %><%= i ? ', ' : '' %><%= n.label %><% }); %>
                </span>
              <% } %>
            </div>
          </div>
        </li>
      <% }); %>
    </ul>
  <% } %>
</section>

<%# Пока подтверждение существует, открывать посты по одному — главный затор.
    Когда календарю начнём доверять полностью, этот блок просто убрать. %>
<% if (pending && pending.length > 0) { %>
  <form action="/admin/calendar/approve-batch" method="POST" class="pending-approval">
    <div class="pending-head">
      <h2>Ждут подтверждения — <%= pending.length %></h2>
      <div class="pending-actions">
        <label class="pending-all">
          <input type="checkbox" id="pending-select-all"> выбрать все
        </label>
        <button class="btn" type="submit">✓ Подтвердить выбранные</button>
      </div>
    </div>
    <p class="hint">Без подтверждения планировщик пост не опубликует, даже когда время наступит.</p>
    <div class="pending-list">
      <% pending.forEach(function(post) { %>
        <label class="pending-row">
          <input type="checkbox" name="ids" value="<%= post.id %>">
          <span class="pending-when"><%= post.scheduled_at.slice(5, 16).replace('-', '.').replace(' ', ' · ') %></span>
          <span class="pending-text"><%= (post.news_hook || post.text || '(без текста)').slice(0, 70) %></span>
          <span class="pending-nets">
            <% (targetsByPost[post.id] || []).forEach(function(t) { %><span class="net-badge net-<%= t.status %>"><%= netShort(t.network_key) %></span><% }); %>
          </span>
          <a class="pending-open" href="/admin/calendar/<%= post.id %>" title="Открыть пост">→</a>
        </label>
      <% }); %>
    </div>
  </form>
  <script>
    (function () {
      var all = document.getElementById('pending-select-all');
      if (!all) return;
      all.addEventListener('change', function () {
        document.querySelectorAll('.pending-row input[name="ids"]').forEach(function (c) {
          c.checked = all.checked;
        });
      });
    })();
  </script>
<% } %>

<% if (upcoming.length > 0) { %>
  <h2 class="upcoming-title">Ближайшие 7 дней</h2>
  <div class="upcoming-list">
    <% upcoming.forEach(function(post) { %>
      <a class="upcoming-row" href="/admin/calendar/<%= post.id %>">
        <span class="upcoming-when"><%= post.scheduled_at.slice(5, 16).replace('-', '.').replace(' ', ' · ') %></span>
        <span class="upcoming-text"><%= (post.news_hook || post.text || '(без текста)').slice(0, 60) %></span>
        <span class="upcoming-nets">
          <% (targetsByPost[post.id] || []).forEach(function(t) { %><span class="net-badge net-<%= t.status %>"><%= netShort(t.network_key) %></span><% }); %>
          <% if (post.story) { %><span class="net-badge net-story">🎞</span><% } %>
        </span>
      </a>
    <% }); %>
  </div>
<% } %>

<div class="calendar-grid">
  <% ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'].forEach(function(d) { %>
    <div class="calendar-weekday"><%= d %></div>
  <% }); %>
  <% for (let i = 0; i < firstWeekday; i++) { %>
    <div class="calendar-cell calendar-cell-empty"></div>
  <% } %>
  <% for (let day = 1; day <= daysInMonth; day++) { %>
    <% const cellDate = `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`; %>
    <div class="calendar-cell calendar-cell-day" data-date="<%= cellDate %>">
      <div class="calendar-cell-date"><%= day %></div>
      <% (eventsByDay[day] || []).forEach(function(ev) { %>
        <div class="calendar-event calendar-event-<%= ev.category %>" title="<%= ev.title %>">
          <%= { music: '🎵', cinema: '🎬', fashion: '👗', personal: '🎂' }[ev.category] || '📅' %> <%= ev.title %>
        </div>
      <% }); %>
      <% (postsByDay[String(day).padStart(2, '0')] || []).forEach(function(post) { %>
        <a
          class="calendar-post<%= post.status === 'scheduled' ? ' calendar-post-draggable' : '' %>"
          href="/admin/calendar/<%= post.id %>"
          data-post-id="<%= post.id %>"
          <%= post.status === 'scheduled' ? 'draggable=true' : '' %>
        >
          <span class="badge badge-<%= post.status %>"><%= post.scheduled_at.slice(11, 16) %></span><%= post.status === 'scheduled' && !post.approved ? ' ⏳' : '' %>
          <%= (post.news_hook || post.text || '(без текста)').slice(0, 24) %>
          <span class="calendar-post-nets">
            <% (targetsByPost[post.id] || []).forEach(function(t) { %><span class="net-badge net-<%= t.status %>"><%= netShort(t.network_key) %></span><% }); %>
            <% if (post.story) { %><span class="net-badge net-story">🎞</span><% } %>
          </span>
        </a>
      <% }); %>
    </div>
  <% } %>
</div>

<script>
  // Перетаскивание запланированных постов между днями; клик по посту открывает его как обычная ссылка.
  (function () {
    let draggedId = null;

    document.querySelectorAll('.calendar-post-draggable').forEach(function (el) {
      el.addEventListener('dragstart', function (e) {
        draggedId = el.dataset.postId;
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', draggedId);
        el.classList.add('calendar-post-dragging');
      });
      el.addEventListener('dragend', function () {
        el.classList.remove('calendar-post-dragging');
        draggedId = null;
      });
    });

    document.querySelectorAll('.calendar-cell-day').forEach(function (cell) {
      cell.addEventListener('dragover', function (e) {
        if (!draggedId) return;
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        cell.classList.add('calendar-cell-dropover');
      });
      cell.addEventListener('dragleave', function () {
        cell.classList.remove('calendar-cell-dropover');
      });
      cell.addEventListener('drop', function (e) {
        e.preventDefault();
        cell.classList.remove('calendar-cell-dropover');
        const postId = draggedId || e.dataTransfer.getData('text/plain');
        if (!postId) return;
        fetch('/admin/calendar/' + postId + '/move', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: 'date=' + encodeURIComponent(cell.dataset.date),
        })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (data.ok) {
              window.location.reload();
            } else {
              alert(data.error || 'Не удалось перенести пост.');
            }
          })
          .catch(function () { alert('Не удалось перенести пост.'); });
      });
    });
  })();
</script>

<%- include('partials/footer') %>
