<%- include('partials/header') %>

<p>
  <a href="/admin/calendar?year=<%= post.scheduled_at.slice(0, 4) %>&month=<%= parseInt(post.scheduled_at.slice(5, 7), 10) %>">← Назад к календарю</a>
  &nbsp;·&nbsp;
  <a href="/admin/calendar/new?fromPost=<%= post.id %>">↪ Перепост в другие соцсети</a>
</p>

<div class="admin-toolbar">
  <h1>Пост от <%= post.scheduled_at %></h1>
  <span class="badge badge-<%= post.status %>"><%= post.status %></span>
  <% if (post.story) { %><span class="badge">+ истории</span><% } %>
  <% if (post.status === 'scheduled') { %>
    <% if (post.approved) { %>
      <span class="badge badge-published">✓ подтверждён</span>
    <% } else { %>
      <span class="badge badge-failed">⏳ ждёт подтверждения</span>
    <% } %>
  <% } %>
</div>
<% if (post.status === 'scheduled') { %>
  <form class="inline" action="/admin/calendar/<%= post.id %>/approve" method="POST">
    <% if (post.approved) { %>
      <button class="link-btn" type="submit">Отозвать подтверждение</button>
    <% } else { %>
      <button class="btn" type="submit">✓ Подтвердить публикацию</button>
    <% } %>
  </form>
  <p class="hint"><%= post.approved ? 'Пост выйдет автоматически в назначенное время.' : 'Без подтверждения планировщик пост НЕ опубликует, даже когда время наступит.' %></p>
<% } %>
<% if (post.link_url) { %>
  <p>Ссылка поста: <a href="<%= post.link_url %>" target="_blank"><%= post.link_url %></a></p>
<% } %>

<p><%= post.text %></p>

<% if (post.media_path) { %>
  <% if (post.media_type === 'video') { %>
    <video src="<%= post.media_path %>" controls style="max-width:360px;"></video>
  <% } else { %>
    <img src="<%= post.media_path %>" alt="" style="max-width:360px;border-radius:8px;">
  <% } %>
<% } %>

<h2>Статус по соцсетям</h2>
<table>
  <thead>
    <tr>
      <th>Сеть</th>
      <th>Статус</th>
      <th>Ссылка</th>
      <th>Статистика</th>
      <th>Ошибка</th>
    </tr>
  </thead>
  <tbody>
    <% targets.forEach(function(t) { %>
      <% let stats = null; try { stats = JSON.parse(t.stats || '{}'); } catch (e) {} %>
      <tr>
        <td><%= t.network_label || t.network_key %></td>
        <td>
          <span class="badge badge-<%= t.status %>"><%= t.status %></span>
          <% if (t.story_status) { %>
            <br><small>история: <span class="badge badge-<%= t.story_status %>"><%= t.story_status %></span></small>
            <% if (t.story_error) { %><br><small><%= t.story_error %></small><% } %>
          <% } %>
        </td>
        <td><% if (t.published_url) { %><a href="<%= t.published_url %>" target="_blank"><%= t.published_url %></a><% } %></td>
        <td>
          <% if (stats && stats.likes !== undefined) { %>
            👍 <%= stats.likes %> · 🔁 <%= stats.reposts %> · 💬 <%= stats.comments %> · 👁 <%= stats.views %>
          <% } %>
          <% if (t.status === 'published' && t.network_connector === 'vk') { %>
            <form class="inline" action="/admin/calendar/<%= post.id %>/targets/<%= t.id %>/refresh-stats" method="POST">
              <button class="link-btn" type="submit">Обновить</button>
            </form>
          <% } %>
        </td>
        <td><%= t.error %></td>
      </tr>
    <% }); %>
  </tbody>
</table>

<h2>Ссылки</h2>
<p style="color:var(--color-muted); font-size:0.9rem; margin-top:-6px;">
  Откуда взят материал и куда он вышел. Заполняется в любой момент, в том числе
  после публикации — чтобы потом не искать заново.
</p>

<form action="/admin/calendar/<%= post.id %>/links" method="POST">
  <label>
    Источники
    <textarea name="sources" rows="3" placeholder="по одной ссылке в строке: статья, исследование, первоисточник"><%= post.sources || '' %></textarea>
  </label>

  <% if (targets.length) { %>
    <p style="margin-bottom:6px;"><strong>Где опубликовано</strong></p>
    <% targets.forEach(function(t) { %>
      <label>
        <%= t.network_label || t.network_key %>
        <input type="url" name="url_<%= t.id %>" value="<%= t.published_url || '' %>"
               placeholder="https://…">
      </label>
    <% }); %>
  <% } %>

  <button class="btn" type="submit">Сохранить ссылки</button>
</form>

<% if (post.status === 'archived') { %>
  <div class="flash flash-info">
    Пост в архиве: планировщик его не тронет. Вернуть — и он снова
    появится в календаре, но без подтверждения: дату стоит перепроверить.
  </div>
  <form class="inline" action="/admin/calendar/<%= post.id %>/restore" method="POST">
    <button class="btn" type="submit">Вернуть из архива</button>
  </form>
<% } else if (post.status === 'scheduled') { %>
  <a class="btn" href="/admin/calendar/<%= post.id %>/edit">Редактировать</a>
  <form class="inline" action="/admin/calendar/<%= post.id %>/archive" method="POST">
    <button class="link-btn" type="submit">В архив</button>
  </form>
<% } else { %>
  <p style="color:var(--color-muted); font-size:0.9rem;">
    Пост уже опубликован, поэтому текст и дата не редактируются — в сетях они
    от этого не изменятся. Правятся только ссылки выше.
  </p>
<% } %>
<% if (post.status !== 'archived') { %>
<form class="inline" action="/admin/calendar/<%= post.id %>/publish" method="POST">
  <button class="btn" type="submit">Опубликовать сейчас</button>
</form>
<% } %>
<form class="inline" action="/admin/calendar/<%= post.id %>/delete" method="POST" onsubmit="return confirm('Удалить пост?');">
  <button class="link-btn" type="submit">Удалить</button>
</form>

<p><a href="/admin/calendar">← Ко всем постам</a></p>

<%- include('partials/footer') %>
