<%- include('partials/header') %>

<h1><%= track && track.id ? 'Редактировать трек' : 'Новый трек' %></h1>

<% if (error) { %>
  <div class="flash flash-error"><%= error %></div>
<% } %>

<form
  action="<%= track && track.id ? `/admin/tracks/${track.id}` : '/admin/tracks' %>"
  method="POST"
  enctype="multipart/form-data"
>
  <label>
    Название *
    <input type="text" name="title" value="<%= track ? track.title : '' %>" required>
  </label>
  <label>
    Релиз (альбом/EP)
    <select name="releaseId">
      <option value="">— отдельный сингл, без релиза —</option>
      <% releases.forEach(function(r) { %>
        <option value="<%= r.id %>" <%= track && Number(track.release_id) === r.id ? 'selected' : '' %>><%= r.title %></option>
      <% }); %>
    </select>
  </label>
  <label>
    О чём трек — смысл, история написания
    <textarea name="description" rows="6"><%= track ? track.description : '' %></textarea>
  </label>
  <p class="hint">Чтобы вставить ссылку в текст: <code>[текст ссылки](https://example.com)</code></p>
  <label>
    Ссылка «слушать»
    <input type="url" name="url" value="<%= track ? track.url : '' %>" placeholder="https://...">
  </label>
  <label>
    Клип — ссылка на видео (YouTube, Rutube, VK Видео, Vimeo)
    <input type="url" name="videoUrl" value="<%= track ? (track.video_url || '') : '' %>" placeholder="https://www.youtube.com/watch?v=...">
  </label>
  <label>
    Формат видео
    <select name="videoFormat">
      <option value="landscape" <%= !track || (track.video_format || 'landscape') === 'landscape' ? 'selected' : '' %>>Горизонтальное 16:9</option>
      <option value="portrait" <%= track && track.video_format === 'portrait' ? 'selected' : '' %>>Вертикальное 9:16 (shorts, вертикалка)</option>
    </select>
  </label>
  <p class="hint">Клип покажется плеером на странице трека. Ссылку из плейлиста (с list=) вставлять можно: после клипа плеер продолжит подборку.</p>
  <label>
    Обложка
    <input type="file" name="cover" accept="image/*">
  </label>
  <% if (track && track.cover_image) { %>
    <img src="<%= track.cover_image %>" alt="" style="width:120px;border-radius:8px;margin-bottom:14px;">
  <% } %>
  <label>
    Порядок сортировки
    <input type="number" name="sortOrder" value="<%= track ? track.sort_order : 0 %>">
  </label>
  <label>
    <input type="checkbox" name="isPublished" value="1" style="width:auto;display:inline-block;"
      <%= !track || track.is_published ? 'checked' : '' %>>
    Опубликован
  </label>
  <button class="btn" type="submit">Сохранить</button>
</form>

<% if (track && track.id && track.release_id && track.slug) { %>
  <p class="hint">
    Страница трека: <a href="/music/<%= releases.find(function(r){return r.id === Number(track.release_id);}).slug %>/<%= track.slug %>" target="_blank">открыть ↗</a>.
    Фото/видео для галереи этого трека загружаются в разделе «Галерея» — выберите этот трек в поле «Показывать на странице».
  </p>
<% } %>

<%- include('partials/footer') %>
