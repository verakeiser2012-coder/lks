<%- include('partials/header') %>

<h1>Стиль: тексты, вещи, голоса</h1>

<% if (saved) { %>
  <div class="flash flash-success">Сохранено.</div>
<% } %>

<p class="hint">
  Вводный текст раздела — в <a href="/admin/pages/style">Стиль</a>. Фото и видео для блоков «Образы»,
  «Проходка» и «Кино» — в <a href="/admin/gallery">Галерее</a>: выберите страницу «Стиль — образы»,
  «Стиль — проходки» или «Стиль — кино». У проходок обязательно укажите дату съёмки: по году идёт игра «Угадай год».
</p>

<form action="/admin/style-items/texts" method="POST">
  <% Object.keys(textLabels).forEach(function(key) { %>
    <label>
      <%= textLabels[key] %>
      <textarea name="<%= key %>" rows="2"><%= texts[key] %></textarea>
    </label>
  <% }); %>
  <p class="hint">Ссылка в тексте: <code>[текст ссылки](https://example.com)</code></p>
  <button class="btn" type="submit">Сохранить тексты</button>
</form>

<div class="admin-toolbar">
  <h2>Что ношу</h2>
  <a class="btn" href="/admin/style-items/new">+ Добавить вещь</a>
</div>

<table>
  <thead>
    <tr>
      <th>Фото</th>
      <th>Вещь</th>
      <th>История</th>
      <th>Опубликована</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% items.forEach(function(item) { %>
      <tr>
        <td><% if (item.photo) { %><img src="<%= item.photo %>" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:4px;"><% } %></td>
        <td><%= item.name %></td>
        <td><%= (item.story || '').slice(0, 80) %></td>
        <td><%= item.is_published ? 'Да' : 'Нет' %></td>
        <td>
          <a href="/admin/style-items/<%= item.id %>/edit">Изменить</a>
          <form class="inline" action="/admin/style-items/<%= item.id %>/delete" method="POST" onsubmit="return confirm('Удалить?');">
            <button class="link-btn" type="submit">Удалить</button>
          </form>
        </td>
      </tr>
    <% }); %>
    <% if (items.length === 0) { %>
      <tr><td colspan="5">Пока пусто. Три-пять вещей с одной фразой про каждую — этого достаточно для старта.</td></tr>
    <% } %>
  </tbody>
</table>

<h2>Голоса за образы</h2>
<p class="hint">Посетители отмечают образ, который хотят увидеть на следующей съёмке. Один голос с устройства на образ.</p>
<table>
  <thead><tr><th>Образ</th><th>Подпись</th><th>Голосов</th></tr></thead>
  <tbody>
    <% votes.forEach(function(v) { %>
      <tr>
        <td><img src="<%= v.file_path %>" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:4px;"></td>
        <td><%= v.title || '(без подписи)' %></td>
        <td><%= v.votes %></td>
      </tr>
    <% }); %>
    <% if (votes.length === 0) { %><tr><td colspan="3">В галерее нет кадров со страницей «Стиль — образы».</td></tr><% } %>
  </tbody>
</table>

<%- include('partials/footer') %>
