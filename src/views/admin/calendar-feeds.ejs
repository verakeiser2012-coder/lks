<%- include('partials/header') %>

<div class="admin-toolbar">
  <h1>Ленты площадок</h1>
  <div>
    <a href="/admin/calendar">← К календарю</a>
    &nbsp;&nbsp;
    <form class="inline" action="/admin/calendar/feeds/refresh" method="POST">
      <button class="btn" type="submit">Обновить ленты сейчас</button>
    </form>
  </div>
</div>

<% if (notice) { %>
  <div class="flash flash-success"><%= notice %></div>
<% } %>
<% if (error) { %>
  <div class="flash flash-error"><%= error %></div>
<% } %>

<%# Спонтанные публикации мимо календаря — репост в X, пост в Facebook, статья в Дзене.
    Просим только ссылку: площадку и время определяем сами. Блок переехал сюда с календаря
    (18.09.2026): записал — и тут же видишь, в какую полосу легло. %>
<section class="feed-log">
  <div class="feed-head">
    <h2>Уже в ленте</h2>
    <form class="feed-form" action="/admin/calendar/log" method="POST">
      <input type="url" name="url" placeholder="Ссылка на публикацию" required>
      <input type="text" name="text" placeholder="О чём — необязательно">
      <button class="btn" type="submit">Записать</button>
    </form>
  </div>
  <p class="feed-hint">Опубликовали руками — вставьте ссылку. Площадку и время определим сами, запись появится в полосе площадки ниже.</p>
  <% if (gaps.length) { %>
    <p class="feed-hint" style="margin-top:12px;"><b>Вышло не везде</b> — можно перепостить:</p>
    <ul class="feed-gaps">
      <% gaps.forEach(function (p) { %>
        <li>
          <span class="feed-when"><%= String(p.scheduled_at).slice(5, 16).replace('-', '.') %></span>
          <a href="/admin/calendar/<%= p.id %>"><%= String(p.text).split('\n')[0].slice(0, 60) || '(без текста)' %></a>
          <span class="feed-missing">→ <% p.missing.forEach(function (n, i) { %><%= i ? ', ' : '' %><%= n.label %><% }); %></span>
        </li>
      <% }); %>
    </ul>
  <% } %>
</section>

<p class="hint">
  По одной полосе на каждую подключённую соцсеть: что там уже лежит, когда было последнее и сколько
  стоит в очереди. Telegram, YouTube и Rutube подтягиваются сами раз в час; остальные площадки из России
  ленту не отдают — по ним видно только то, что опубликовал календарь или что вы записали руками
  через «Уже в ленте». Кнопка справа у каждой полосы открывает живую ленту на самой площадке.
</p>

<%# Полосы без публикаций и без источника импорта — одной строкой:
    девять пустых секций подряд прячут те, где есть что смотреть. %>
<% const quiet = feeds.filter((f) => f.items.length === 0 && !f.importedVia);
   const active = feeds.filter((f) => !(f.items.length === 0 && !f.importedVia)); %>

<% active.forEach(function (f) { %>
  <section class="feed-lane">
    <div class="feed-lane-head">
      <div class="feed-lane-title">
        <h2><%= f.label %></h2>
        <span class="badge"><%= f.published %> в ленте</span>
        <% if (f.queued) { %><span class="badge badge-scheduled"><%= f.queued %> в очереди</span><% } %>
        <% if (f.lastAt) { %><span class="feed-lane-last">последнее <%= String(f.lastAt).slice(0, 16) %></span><% } %>
        <% if (f.importedVia) { %><span class="feed-lane-src">читаем: <%= f.importedVia %></span><% } else { %><span class="feed-lane-src">вручную</span><% } %>
      </div>
      <div class="feed-lane-actions">
        <% if (f.key === 'instagram' || f.key === 'instagram-djlevka') { %>
          <a href="/admin/calendar/instagram-grid">Превью сетки</a>
        <% } %>
        <% if (f.liveUrl) { %>
          <a class="btn btn-small" href="<%= f.liveUrl %>" target="_blank" rel="noopener">Открыть ленту ↗</a>
        <% } %>
      </div>
    </div>

    <% if (f.items.length === 0) { %>
      <p class="feed-empty">Пока пусто: импорт ничего не нашёл, календарь сюда не публиковал, записей руками нет.</p>
    <% } else { %>
      <div class="feed-strip">
        <% f.items.forEach(function (p) { %>
          <article class="feed-card">
            <a class="feed-thumb" href="<%= p.published_url || ('/admin/calendar/' + p.id) %>" <%= p.published_url ? 'target="_blank" rel="noopener"' : '' %>>
              <% if (p.thumb_url) { %>
                <img src="<%= p.thumb_url %>" alt="" loading="lazy" referrerpolicy="no-referrer">
              <% } else if (p.media_path && p.media_type !== 'video') { %>
                <img src="<%= thumb(p.media_path, 320) %>" alt="" loading="lazy">
              <% } else if (p.media_path && p.media_type === 'video') { %>
                <video src="<%= p.media_path %>" muted preload="metadata"></video>
              <% } else { %>
                <span class="feed-thumb-empty"><%= p.media_type === 'video' ? '▶' : '✎' %></span>
              <% } %>
              <% if (p.media_type === 'video') { %><span class="feed-play">▶</span><% } %>
              <% if (p.frames > 1) { %><span class="feed-frames"><%= p.frames %> кадр<%= p.frames < 5 ? 'а' : 'ов' %></span><% } %>
            </a>
            <div class="feed-card-body">
              <div class="feed-when"><%= String(p.scheduled_at).slice(0, 16) %></div>
              <a class="feed-text" href="/admin/calendar/<%= p.id %>"><%= String(p.text).split('\n')[0].slice(0, 70) || '(без текста)' %></a>
              <% if (p.published_url) { %>
                <a class="feed-link" href="<%= p.published_url %>" target="_blank" rel="noopener">на площадке ↗</a>
              <% } %>
            </div>
          </article>
        <% }); %>
      </div>
    <% } %>
  </section>
<% }); %>

<% if (quiet.length > 0) { %>
  <section class="feed-lane feed-lane--quiet">
    <div class="feed-lane-head">
      <div class="feed-lane-title">
        <h2>Ленту не отдают</h2>
        <span class="feed-lane-src">эти площадки из России читать нельзя — публикации туда записывайте руками через «Уже в ленте»</span>
      </div>
    </div>
    <ul class="feed-quiet-list">
      <% quiet.forEach(function (f) { %>
        <li>
          <span><%= f.label %></span>
          <% if (f.queued) { %><span class="badge badge-scheduled"><%= f.queued %> в очереди</span><% } %>
          <% if (f.liveUrl) { %><a href="<%= f.liveUrl %>" target="_blank" rel="noopener">открыть ↗</a><% } %>
        </li>
      <% }); %>
    </ul>
  </section>
<% } %>

<%- include('partials/footer') %>
