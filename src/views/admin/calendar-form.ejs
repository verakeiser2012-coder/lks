<%- include('partials/header') %>

<p>
  <a href="<%= post ? `/admin/calendar?year=${post.scheduled_at.slice(0, 4)}&month=${parseInt(post.scheduled_at.slice(5, 7), 10)}` : '/admin/calendar' %>">← Назад к календарю</a>
  <% if (post) { %>
    &nbsp;·&nbsp; <a href="/admin/calendar/<%= post.id %>">К странице поста</a>
  <% } %>
</p>

<h1><%= post ? 'Редактировать пост' : 'Запланировать пост' %></h1>

<% if (error) { %>
  <div class="flash flash-error"><%= error %></div>
<% } %>

<form
  action="<%= post ? `/admin/calendar/${post.id}/edit` : '/admin/calendar' %>"
  method="POST"
  enctype="multipart/form-data"
>
  <label>
    Текст поста
    <textarea name="text" id="post-text" rows="5"><%= post ? post.text : (prefill ? prefill.text : '') %></textarea>
  </label>
  <div id="hashtag-suggest" class="hint" style="display:none;">
    Предложенные хэштеги: <span id="hashtag-list"></span>
    <button type="button" class="link-btn" id="hashtag-apply">Добавить в текст</button>
  </div>
  <label>
    Дата и время публикации
    <input
      type="datetime-local"
      name="scheduledAt"
      required
      value="<%= post ? post.scheduled_at.replace(' ', 'T').slice(0, 16) : '' %>"
    >
  </label>
  <label>
    Тип медиа (если прикладываете файл)
    <select name="type">
      <option value="photo" <%= (post && post.media_type === 'photo') || (prefill && prefill.mediaType === 'photo') ? 'selected' : '' %>>Фото</option>
      <option value="video" <%= (post && post.media_type === 'video') || (prefill && prefill.mediaType === 'video') ? 'selected' : '' %>>Видео</option>
    </select>
  </label>
  <% if (prefill && prefill.mediaPath) { %>
    <p class="hint">Медиа скопировано из исходного поста/новости — можно оставить как есть или заменить файлом ниже.</p>
    <input type="hidden" name="prefillMediaPath" value="<%= prefill.mediaPath %>">
    <input type="hidden" name="prefillMediaType" value="<%= prefill.mediaType %>">
  <% } %>
  <label>
    Файл <%= post && post.media_path ? '(оставьте пустым, чтобы не менять)' : '(необязательно)' %>
    <input type="file" name="file" accept="image/*,video/*">
  </label>
  <% if (post) { %>
    <p class="hint">Соцсети нельзя изменить после создания поста — удалите и создайте новый с другим набором.</p>
  <% } else { %>
    <label>
      Соцсети
      <% [['music', '🎵 Музыка'], ['shorts', '📱 Видеовертикалки'], ['general', 'Остальные']].forEach(function(group) { %>
        <% const groupNets = networks.filter(function(n) { return (n.category || 'general') === group[0]; }); %>
        <% if (groupNets.length > 0) { %>
          <div class="network-group-title"><%= group[1] %></div>
          <% groupNets.forEach(function(n) { %>
            <div>
              <input type="checkbox" name="networks" value="<%= n.key %>" id="net-<%= n.key %>" style="width:auto;display:inline-block;">
              <label for="net-<%= n.key %>" style="display:inline;font-weight:normal;">
                <%= n.label %><% if (!n.enabled) { %> <span class="badge badge-disabled">не подключено</span><% } %>
              </label>
            </div>
          <% }); %>
        <% } %>
      <% }); %>
    </label>
  <% } %>
  <button class="btn" type="submit"><%= post ? 'Сохранить' : 'Запланировать' %></button>
</form>

<script>
  // Живой подбор хэштегов: правила лежат на сервере (src/utils/hashtags.js), тут только показ.
  (function () {
    const textarea = document.getElementById('post-text');
    const box = document.getElementById('hashtag-suggest');
    const list = document.getElementById('hashtag-list');
    const applyBtn = document.getElementById('hashtag-apply');
    if (!textarea) return;
    let timer = null;
    let current = [];

    function refresh() {
      const text = textarea.value.trim();
      if (!text) { box.style.display = 'none'; return; }
      fetch('/admin/calendar/hashtags', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: text }),
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          current = data.hashtags || [];
          if (current.length === 0) { box.style.display = 'none'; return; }
          list.textContent = current.join(' ');
          box.style.display = 'block';
        })
        .catch(function () { box.style.display = 'none'; });
    }

    textarea.addEventListener('input', function () {
      clearTimeout(timer);
      timer = setTimeout(refresh, 500);
    });
    applyBtn.addEventListener('click', function () {
      if (current.length === 0) return;
      textarea.value = textarea.value.replace(/\s+$/, '') + '\n\n' + current.join(' ');
      refresh();
    });
    refresh();
  })();
</script>

<%- include('partials/footer') %>
