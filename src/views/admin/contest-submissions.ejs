<%- include('partials/header') %>

<h1>Заявки на конкурс «Твой выход под трек»</h1>


<p class="hint">Статусы: <b>new</b> — свежая; <b>approved</b> — показывается в галерее сезона; <b>shortlisted</b> — в галерее с пометкой «шорт-лист»; <b>winner</b> — победитель сезона (в галерее первым и в архиве); <b>audience</b> — приз зрительских симпатий, ставить по столбцу «Голоса» после даты итогов; <b>rejected</b> — скрыта. Заявки подростков без подтверждения родителя (ждёт согласия) в галерею не ставить.</p>
<table>
  <thead>
    <tr>
      <th>Имя</th>
      <th>Сезон</th>
      <th>Видео</th>
      <th>Комментарий</th>
      <th>Контакт</th>
      <th>Возраст</th>
      <th>Согласие</th>
      <th>Статус</th>
      <th>Голоса</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% submissions.forEach(function(s) { %>
      <tr>
        <td><%= s.name %></td>
        <td><small><%= s.season || "—" %></small></td>
        <td><a href="<%= s.video_url %>" target="_blank" rel="noopener">видео ↗</a></td>
        <td style="max-width:220px;"><%= s.note %></td>
        <td><%= s.contact %></td>
        <td>
          <% if (s.age_group === 'teen') { %>14–17<br><small><%= s.guardian_name %>, <%= s.guardian_contact %></small>
          <% } else if (s.age_group === 'child') { %>до 14, подал родитель<br><small><%= s.guardian_name %>, <%= s.guardian_contact %></small>
          <% } else { %>18+<% } %>
        </td>
        <td>
          <% if (s.age_group === 'teen') { %>
            <%= s.consent_confirmed_at ? 'родитель подтвердил ' + formatDateShort(s.consent_confirmed_at) : 'ждёт письма родителя' %>
          <% } else if (s.age_group === 'child') { %>родитель в форме<% } else { %>сам(а)<% } %>
        </td>
        <td><%= s.status === 'pending_consent' ? 'ждёт согласия' : s.status %></td>
        <td><%= s.votes || 0 %></td>
        <td>
          <form class="inline" action="/admin/contest/submissions/<%= s.id %>/status" method="POST">
            <select name="status" onchange="this.form.submit()">
              <% ['new', 'approved', 'shortlisted', 'winner', 'audience', 'rejected'].forEach(function(st) { %>
                <option value="<%= st %>" <%= s.status === st ? 'selected' : '' %>><%= st %></option>
              <% }); %>
            </select>
          </form>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>

<%- include('partials/footer') %>
