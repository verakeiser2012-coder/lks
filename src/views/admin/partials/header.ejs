<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Админка' %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon-admin.svg">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
  <header class="admin-header">
    <div class="container admin-header-inner">
      <a class="logo" href="/admin">Админка</a>
      <%
        const navPath = (typeof currentPath === 'string' ? currentPath : '').split('?')[0];
        function navActive(href) {
          if (href === '/admin') return navPath === '/admin' ? 'active' : '';
          return navPath === href || navPath.startsWith(href + '/') ? 'active' : '';
        }
      %>
      <nav class="main-nav">
        <div class="nav-group">
          <span class="nav-group-label">Магазин</span>
          <a href="/admin/products" class="<%= navActive('/admin/products') %>">Товары</a>
          <a href="/admin/collections" class="<%= navActive('/admin/collections') %>">Дропы</a>
          <a href="/admin/orders" class="<%= navActive('/admin/orders') %>">Заказы</a>
          <a href="/admin/busts" class="<%= navActive('/admin/busts') %>">Бюсты</a>
        </div>
        <div class="nav-group">
          <span class="nav-group-label">Музыка</span>
          <a href="/admin/pages/music" class="<%= navActive('/admin/pages/music') %>">Музыка</a>
          <a href="/admin/releases" class="<%= navActive('/admin/releases') %>">Релизы</a>
          <a href="/admin/tracks" class="<%= navActive('/admin/tracks') %>">Треки</a>
        </div>
        <div class="nav-group">
          <span class="nav-group-label">Контент</span>
          <a href="/admin/news" class="<%= navActive('/admin/news') %>">Новости</a>
          <a href="/admin/diary" class="<%= navActive('/admin/diary') %>">Дневник</a>
          <a href="/admin/about" class="<%= navActive('/admin/about') %>">Обо мне</a>
          <a href="/admin/gallery" class="<%= navActive('/admin/gallery') %>">Галерея</a>
          <a href="/admin/pages/style" class="<%= navActive('/admin/pages/style') %>">Стиль</a>
          <a href="/admin/pages/gigs" class="<%= navActive('/admin/pages/gigs') %>">Выступления</a>
        </div>
        <div class="nav-group">
          <span class="nav-group-label">Сообщество</span>
          <a href="/admin/redheads" class="<%= navActive('/admin/redheads') %>">Рыжие</a>
          <a href="/admin/redheads/submissions" class="<%= navActive('/admin/redheads/submissions') %>">Заявки рыжих</a>
          <a href="/admin/contest" class="<%= navActive('/admin/contest') %>">Конкурс</a>
          <a href="/admin/contest/submissions" class="<%= navActive('/admin/contest/submissions') %>">Заявки конкурса</a>
        </div>
        <div class="nav-group">
          <span class="nav-group-label">Продвижение</span>
          <a href="/admin/calendar" class="<%= navActive('/admin/calendar') %>">Календарь</a>
          <a href="/admin/banners" class="<%= navActive('/admin/banners') %>">Баннеры</a>
          <a href="/admin/brands" class="<%= navActive('/admin/brands') %>">Брендам</a>
          <a href="/admin/social-networks" class="<%= navActive('/admin/social-networks') %>">Соцсети</a>
          <a href="/admin/subscribers" class="<%= navActive('/admin/subscribers') %>">Подписчики</a>
          <a href="/admin/messages" class="<%= navActive('/admin/messages') %>">Обращения</a>
        </div>
        <div class="nav-group">
          <a href="/admin/settings" class="<%= navActive('/admin/settings') %>">Настройки</a>
        </div>
        <div class="nav-group">
          <a href="/" target="_blank">Сайт ↗</a>
          <form class="inline" action="/admin/logout" method="POST">
            <button class="link-btn" type="submit">Выйти</button>
          </form>
        </div>
      </nav>
    </div>
  </header>
  <main class="container admin-main">
