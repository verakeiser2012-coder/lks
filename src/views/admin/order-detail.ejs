<%- include('partials/header') %>

<h1>Заказ №<%= order.id %></h1>

<p>Клиент: <%= order.customer_name %> · <%= order.phone %> <% if (order.email) { %>· <%= order.email %><% } %></p>
<% if (order.delivery_method === 'pickup') { %>
  <p>Получение: пункт выдачи — <%= order.pickup_point %></p>
<% } else if (order.address) { %>
  <p>Адрес: <%= [order.country, order.zip, order.city, order.address].filter(Boolean).join(', ') %></p>
<% } %>
<% if (order.comment) { %><p>Комментарий: <%= order.comment %></p><% } %>
<p>Оплата: <%= order.payment_status %> (<%= order.payment_provider || '—' %>)</p>

<table>
  <thead>
    <tr><th>Товар</th><th>Цена</th><th>Кол-во</th><th>Сумма</th><th>Печать</th></tr>
  </thead>
  <tbody>
    <% items.forEach(function(item) { %>
      <tr>
        <td><%= item.product_name %><% if (item.variant) { %> · <%= item.variant %><% } %></td>
        <td><%= formatPrice(item.price) %></td>
        <td><%= item.qty %></td>
        <td><%= formatPrice(item.price * item.qty) %></td>
        <td><%= ({ sent: 'в Printful (черновик ' + item.fulfillment_ref + ')', manual: 'вручную', failed: 'ошибка' })[item.fulfillment_status] || '' %></td>
      </tr>
    <% }); %>
  </tbody>
</table>

<% if (order.shipping_cost) { %>
  <p>Доставка: <%= order.shipping_carrier === 'cdek' ? 'СДЭК' : order.shipping_carrier %>, <%= order.shipping_tariff === 'pickup' ? 'до пункта выдачи' : 'до двери' %> — <%= formatPrice(order.shipping_cost) %><%= order.shipping_days ? ', ' + order.shipping_days + ' дн.' : '' %></p>
<% } %>
<p><strong>Итого: <%= formatPrice(order.total) %></strong><% if (order.shipping_cost) { %> <span style="color:var(--color-muted);font-weight:normal;">(вещи <%= formatPrice(order.total - order.shipping_cost) %> + доставка)</span><% } %></p>

<% if (printful) { %>
  <% if (printfulResult) { %><div class="flash flash-success">Printful: <%= printfulResult %></div><% } %>
  <form action="/admin/orders/<%= order.id %>/printful" method="POST" style="margin-bottom:16px;">
    <button class="btn" type="submit" <%= order.payment_status !== 'paid' ? 'disabled' : '' %>>Отправить в Printful ещё раз</button>
    <% if (order.payment_status !== 'paid') { %><span style="color:#666; font-size:0.85rem;"> — только после оплаты</span><% } %>
  </form>
<% } %>

<form action="/admin/orders/<%= order.id %>/status" method="POST">
  <label>
    Статус заказа
    <select name="status">
      <% ['new', 'processing', 'shipped', 'completed', 'cancelled'].forEach(function(s) { %>
        <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s %></option>
      <% }); %>
    </select>
  </label>
  <button class="btn" type="submit">Сохранить статус</button>
</form>

<p><a href="/admin/orders">← Ко всем заказам</a></p>

<%- include('partials/footer') %>
