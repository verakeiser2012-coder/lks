<%- include('partials/header') %>

<h1>Рыжие, которые вдохновляют</h1>

<% if (saved) { %>
  <div class="flash flash-success">Сохранено.</div>
<% } %>

<form action="/admin/redheads/intro" method="POST">
  <label>
    Вводный текст
    <textarea name="intro" rows="3"><%= intro %></textarea>
  </label>
  <p class="hint">Чтобы вставить ссылку в текст: <code>[текст ссылки](https://example.com)</code></p>
  <button class="btn" type="submit">Сохранить текст</button>
</form>

<div class="admin-toolbar">
  <h2>Подборка</h2>
  <a class="btn" href="/admin/redheads/new">+ Добавить человека</a>
</div>

<table>
  <thead>
    <tr>
      <th>Фото</th>
      <th>Имя</th>
      <th>Роль</th>
      <th>Опубликован</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% people.forEach(function(person) { %>
      <tr>
        <td>
          <% if (person.photo) { %><img src="<%= person.photo %>" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:4px;"><% } %>
        </td>
        <td><%= person.name %></td>
        <td><%= person.role %></td>
        <td><%= person.is_published ? 'Да' : 'Нет' %></td>
        <td>
          <a href="/admin/redheads/<%= person.id %>/edit">Изменить</a>
          <form class="inline" action="/admin/redheads/<%= person.id %>/delete" method="POST" onsubmit="return confirm('Удалить?');">
            <button class="link-btn" type="submit">Удалить</button>
          </form>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>

<%- include('partials/footer') %>
