<%- include('partials/header') %>

<div class="admin-toolbar">
  <h1>Новая новость</h1>
  <a href="/admin/news">← К новостям</a>
</div>

<% if (error) { %>
  <div class="flash flash-error"><%= error %></div>
<% } %>

<form action="/admin/news" method="POST">
  <label>
    Заголовок *
    <input type="text" name="title" id="news-title" required>
  </label>
  <label>
    Текст
    <textarea name="content" id="news-content" rows="8"></textarea>
  </label>
  <div class="translate-row">
    <button type="button" class="btn translate-btn" data-translate-from="#news-title,#news-content" data-translate-to="#news-title,#news-content" data-translate-then-select="select[name=lang]" data-translate-then-value="en">Перевести заголовок и текст на английский (заменит поля, язык станет EN)</button>
    <span class="hint" style="margin:0;">Для английской версии уже сохранённой русской новости лучше открыть её и нажать «Создать английскую версию» — тогда переключатель RU/EN на сайте свяжет их.</span>
  </div>
  <p class="flash">Чтобы вставить ссылку в текст, используйте формат: <code>[текст ссылки](https://...)</code> — работает и с внутренними ссылками вида <code>/news/...</code></p>
  <label>
    Язык
    <select name="lang">
      <option value="ru" selected>Русский (/news)</option>
      <option value="en">English (/en/news)</option>
    </select>
  </label>
  <label>
    <input type="checkbox" name="isPublished" value="1" style="width:auto;display:inline-block;" checked>
    Опубликовать
  </label>
  <button class="btn" type="submit">Создать</button>
</form>

<p class="flash">Фото и видео можно будет добавить после сохранения новости.</p>

<script src="/js/admin-translate.js?v=<%= assetVer %>"></script>

<%- include('partials/footer') %>
