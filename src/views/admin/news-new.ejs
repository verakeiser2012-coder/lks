<%- include('partials/header') %>

<h1>Новая новость</h1>

<% if (error) { %>
  <div class="flash flash-error"><%= error %></div>
<% } %>

<form action="/admin/news" method="POST">
  <label>
    Заголовок *
    <input type="text" name="title" required>
  </label>
  <label>
    Текст
    <textarea name="content" rows="8"></textarea>
  </label>
  <p class="flash">Чтобы вставить ссылку в текст, используйте формат: <code>[текст ссылки](https://...)</code></p>
  <label>
    <input type="checkbox" name="isPublished" value="1" style="width:auto;display:inline-block;" checked>
    Опубликовать
  </label>
  <button class="btn" type="submit">Создать</button>
</form>

<p class="flash">Фото и видео можно будет добавить после сохранения новости.</p>

<%- include('partials/footer') %>
