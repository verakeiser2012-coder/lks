<%- include('partials/header') %>

<div class="admin-toolbar">
  <h1>Дневник</h1>
  <a class="btn" href="/admin/diary/new">+ Новая запись</a>
</div>

<table>
  <thead>
    <tr>
      <th>Заголовок</th>
      <th>Дата</th>
      <th>Дзен</th>
      <th>Опубликована</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% posts.forEach(function(p) { %>
      <tr>
        <td><%= p.title %></td>
        <td><%= formatDate(p.created_at) %></td>
        <td><%= p.dzen_url ? 'Да' : '—' %></td>
        <td><%= p.is_published ? 'Да' : 'Нет' %></td>
        <td>
          <a href="/admin/diary/<%= p.id %>/edit">Изменить</a>
          <a href="/diary/<%= p.slug %>" target="_blank">Смотреть ↗</a>
          <form class="inline" action="/admin/diary/<%= p.id %>/delete" method="POST" onsubmit="return confirm('Удалить запись из дневника?');">
            <button class="link-btn" type="submit">Удалить</button>
          </form>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>

<%- include('partials/footer') %>
