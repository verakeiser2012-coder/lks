<%- include('partials/header') %>

<div class="admin-toolbar">
  <h1>Релизы</h1>
  <a class="btn" href="/admin/releases/new">+ Новый релиз</a>
</div>

<table>
  <thead>
    <tr>
      <th>Обложка</th>
      <th>Название</th>
      <th>Год</th>
      <th>Треков</th>
      <th>Опубликован</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% releases.forEach(function(r) { %>
      <tr>
        <td>
          <% if (r.cover_image) { %><img src="<%= r.cover_image %>" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:4px;"><% } %>
        </td>
        <td><%= r.title %></td>
        <td><%= r.year %></td>
        <td><%= r.trackCount %></td>
        <td><%= r.is_published ? 'Да' : 'Нет' %></td>
        <td>
          <a href="/admin/releases/<%= r.id %>/edit">Изменить</a>
          <a href="/music/<%= r.slug %>" target="_blank">Смотреть ↗</a>
          <form class="inline" action="/admin/releases/<%= r.id %>/delete" method="POST" onsubmit="return confirm('Удалить релиз? Треки останутся, но потеряют привязку к нему.');">
            <button class="link-btn" type="submit">Удалить</button>
          </form>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>

<%- include('partials/footer') %>
