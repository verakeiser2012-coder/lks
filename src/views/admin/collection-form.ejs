<%- include('partials/header') %>

<h1><%= collection && collection.id ? 'Редактировать дроп' : 'Новый дроп' %></h1>

<% if (error) { %>
  <div class="flash flash-error"><%= error %></div>
<% } %>

<form
  action="<%= collection && collection.id ? `/admin/collections/${collection.id}` : '/admin/collections' %>"
  method="POST"
>
  <label>
    Название *
    <input type="text" name="name" value="<%= collection ? collection.name : '' %>" required>
  </label>
  <label>
    Подзаголовок
    <input type="text" name="subtitle" value="<%= collection ? collection.subtitle : '' %>" placeholder="Например: коллаборация с мастерской «Флёр»">
  </label>
  <label>
    Сезон/повод
    <input type="text" name="seasonLabel" value="<%= collection ? collection.season_label : '' %>" placeholder="Осень 2026">
  </label>
  <label>
    Описание
    <textarea name="description" rows="6"><%= collection ? collection.description : '' %></textarea>
  </label>
  <p class="hint">Чтобы вставить ссылку в текст: <code>[текст ссылки](https://example.com)</code></p>
  <label>
    Порядок сортировки
    <input type="number" name="sortOrder" value="<%= collection ? collection.sort_order : 0 %>">
  </label>
  <label>
    <input type="checkbox" name="isPublished" value="1" style="width:auto;display:inline-block;"
      <%= !collection || collection.is_published ? 'checked' : '' %>>
    Опубликован
  </label>
  <button class="btn" type="submit">Сохранить</button>
</form>

<% if (collection && collection.id) { %>
  <p class="hint">Чтобы привязать товары к этому дропу — откройте товар в разделе «Товары» и выберите дроп в форме.</p>
<% } %>

<%- include('partials/footer') %>
