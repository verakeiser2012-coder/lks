<%- include('partials/header') %>

<section class="hero drop-hero">
  <% if (collection.cover_image) { %><img class="release-hero-cover" src="<%= thumb(collection.cover_image, 480) %>" srcset="<%= srcset(collection.cover_image, [320, 480, 640, 960]) %>" sizes="(max-width: 480px) 92vw, 200px" alt="<%= collection.name %>"><% } %>
  <div>
    <% if (collection.season_label) { %><p class="drop-season">Дроп · <%= collection.season_label %></p><% } %>
    <h1><%= collection.name %></h1>
    <% if (collection.subtitle) { %><p class="hero-tagline"><%= collection.subtitle %></p><% } %>
  </div>
</section>

<% if (collection.description) { %>
  <div class="prose drop-description"><%- renderLinkedText(collection.description) %></div>
<% } %>

<% if (products.length === 0) { %>
  <p class="drop-soon">Товары этого дропа появятся в каталоге совсем скоро.</p>
<% } else { %>
  <div class="product-grid">
    <% products.forEach(function(product) { %>
      <a class="product-card" href="/catalog/<%= product.slug %>">
        <div class="product-image">
          <% if (product.image) { %>
            <img src="<%= thumb(product.image, 640) %>" srcset="<%= srcset(product.image) %>" sizes="(max-width: 640px) 92vw, (max-width: 1000px) 46vw, 300px" alt="<%= product.name %>">
          <% } else { %>
            <div class="no-image">Нет фото</div>
          <% } %>
        </div>
        <div class="product-name"><%= product.name %></div>
        <div class="product-price"><%= priceLabel(product) %></div>
      </a>
    <% }); %>
  </div>
<% } %>

<% if (typeof diaryPosts !== 'undefined' && diaryPosts.length > 0) { %>
  <%# Записи дневника, привязанные к дропу: история капсулы словами Льва. %>
  <section class="drop-diary">
    <h2>Об этом дропе в дневнике</h2>
    <div class="news-list">
      <% diaryPosts.forEach(function(p) { %>
        <a class="news-card" href="/diary/<%= p.slug %>">
          <div class="news-card-image">
            <% if (p.cover_image) { %>
              <img src="<%= thumb(p.cover_image, 640) %>" srcset="<%= srcset(p.cover_image) %>" sizes="(max-width: 640px) 92vw, (max-width: 1000px) 46vw, 300px" alt="<%= p.title %>" loading="lazy">
            <% } else { %>
              <div class="no-image">Нет фото</div>
            <% } %>
          </div>
          <div>
            <div class="news-date"><%= formatDate(p.created_at) %></div>
            <div class="news-title"><%= p.title %></div>
            <% if (p.excerpt) { %><p class="drop-subtitle"><%= p.excerpt %></p><% } %>
          </div>
        </a>
      <% }); %>
    </div>
  </section>
<% } %>

<%- include('partials/footer') %>
