<%- include('partials/header') %>

<section class="hero release-hero">
  <% if (release.cover_image) { %><img class="release-hero-cover" src="<%= thumb(release.cover_image, 480) %>" srcset="<%= srcset(release.cover_image, [320, 480, 640, 960]) %>" sizes="(max-width: 480px) 92vw, 200px" alt="<%= release.title %>"><% } %>
  <div>
    <p class="drop-season"><%= release.release_type %><% if (release.year) { %> · <%= release.year %><% } %></p>
    <h1><%= release.title %></h1>
    <% if (release.description) { %><p class="hero-tagline"><%- renderLinkedText(release.description) %></p><% } %>
    <% if (release.streaming_url) { %><a class="neon-pill" href="<%= release.streaming_url %>" target="_blank" rel="noopener">Слушать целиком</a><% } %>
  </div>
</section>

<section class="link-section">
  <h2>Треки</h2>
  <div class="track-playlist">
    <% tracks.forEach(function(track, i) { %>
      <a class="track-row" href="/music/<%= release.slug %>/<%= track.slug %>">
        <span class="track-row-index"><%= i + 1 %></span>
        <% if (track.cover_image) { %><img class="track-row-cover" src="<%= thumb(track.cover_image, 160) %>" alt=""><% } %>
        <span class="track-row-title"><%= track.title %></span>
        <span class="track-row-arrow">→</span>
      </a>
    <% }); %>
  </div>
</section>

<% if (products && products.length) { %>
<section class="link-section">
  <h2>Вещи к релизу</h2>
  <div class="product-grid">
    <% products.forEach(function(product) { %>
      <a class="product-card" href="/catalog/<%= product.slug %>">
        <div class="product-image edge-soft">
          <% if (product.image) { %>
            <img src="<%= thumb(product.image, 640) %>" srcset="<%= srcset(product.image) %>" sizes="(max-width: 640px) 92vw, (max-width: 1000px) 46vw, 300px" alt="<%= product.name %>">
          <% } else { %>
            <div class="no-image">Нет фото</div>
          <% } %>
        </div>
        <div class="product-name"><%= product.name %></div>
        <div class="product-price"><%= formatPrice(product.price) %></div>
      </a>
    <% }); %>
  </div>
</section>
<% } %>

<% if (releaseVideo) { %>
<section class="link-section">
  <h2>Видео</h2>
  <div class="video-embed <%= release.video_format === 'portrait' ? 'is-portrait' : '' %>">
    <iframe src="<%= releaseVideo.embedUrl %>" loading="lazy" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen title="Видео: <%= release.title %>"></iframe>
  </div>
</section>
<% } %>

<%- include('partials/music-strip') %>

<p class="drop-back"><a href="/music">← Все релизы</a></p>

<%- include('partials/share') %>

<%- include('partials/footer') %>
