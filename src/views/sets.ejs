<%- include('partials/header') %>

<section class="hero">
  <h1>Сеты и стемы</h1>
  <p class="hero-tagline">
    Для тех, кто сам делает музыку: длинные записи сетов и отдельные дорожки треков,
    которые можно взять на ремикс или спеть поверх.
  </p>
</section>

<% (banners || []).forEach(function(banner) { %><%- include('partials/banner', { banner }) %><% }); %>

<section class="chapter" id="sets">
  <header class="chapter-head">
    <span class="chapter-num">01</span>
    <h2 class="chapter-title">DJ-сеты</h2>
  </header>
  <p class="chapter-deck">Записи целиком: час транса, весенний сет вдвоём. В стриминги такое не выкладывают — слушать здесь.</p>
  <% if (djSets.length === 0) { %>
    <p class="hint">Записи появятся здесь.</p>
  <% } else { %>
    <div class="set-list">
      <% djSets.forEach(function (s) { %>
        <article class="set-card">
          <div class="set-body">
            <div class="set-meta">
              <% if (s.set_date) { %><span><%= formatDateShort(s.set_date, 'ru') %></span><% } %>
              <% if (s.duration) { %><span><%= s.duration %></span><% } %>
              <% if (s.with_whom) { %><span class="set-with">вместе с <%= s.with_whom %></span><% } %>
            </div>
            <h3 class="set-title"><%= s.title %></h3>
            <% if (s.description) { %><p class="set-note"><%- renderLinkedText(s.description) %></p><% } %>
          </div>
          <% if (s.video) { %>
            <div class="video-embed"><iframe src="<%= s.video.embedUrl %>" loading="lazy" allow="encrypted-media; picture-in-picture" allowfullscreen title="<%= s.title %>"></iframe></div>
          <% } else if (s.audio_url) { %>
            <audio class="track-player" controls preload="none" src="<%= s.audio_url %>"></audio>
          <% } %>
        </article>
      <% }); %>
    </div>
  <% } %>
</section>

<section class="chapter" id="stems">
  <header class="chapter-head">
    <span class="chapter-num">02</span>
    <h2 class="chapter-title">Стемы</h2>
    <a class="chapter-more" href="/contact?topic=question">Запросить стемы →</a>
  </header>
  <p class="chapter-deck">
    Стем — это отдельная дорожка трека: бас, барабаны, синты, без остального. Из них собирают
    ремикс или пишут поверх свой вокал.
  </p>
  <% if (stemPacks.length === 0) { %>
    <p class="hint">Наборы готовятся: сведём дорожки и выложим сюда.</p>
  <% } else { %>
    <div class="stem-list">
      <% stemPacks.forEach(function (p) { %>
        <article class="stem-card">
          <div class="stem-head">
            <h3 class="stem-title">
              <% if (p.track_slug && p.release_slug) { %>
                <a href="/music/<%= p.release_slug %>/<%= p.track_slug %>"><%= p.title || p.track_title %></a>
              <% } else { %><%= p.title || p.track_title %><% } %>
            </h3>
            <% if (p.format) { %><span class="stem-format"><%= p.format %></span><% } %>
          </div>
          <% if (p.tracks_note) { %><p class="stem-note"><%= p.tracks_note %></p><% } %>
          <% if (p.archive_url) { %>
            <a class="btn" href="<%= p.archive_url %>" <% if (p.archive_url.startsWith('http')) { %>target="_blank" rel="noopener"<% } %>>Скачать набор</a>
          <% } else { %>
            <span class="stem-soon">Готовится</span>
          <% } %>
        </article>
      <% }); %>
    </div>
  <% } %>
  <p class="stem-license">
    Условия простые: ремиксы и каверы делать можно, указывайте «DJ Levka» в названии
    и не продавайте результат без нашего согласия. Готовое присылайте — лучшее опубликуем.
  </p>
</section>

<%- include('partials/footer') %>
