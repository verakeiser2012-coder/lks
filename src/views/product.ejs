<%- include('partials/header') %>

<% if (settings.shop_prelaunch_notice) { %>
  <div class="prelaunch-notice">
    <strong>Магазин готовится к запуску.</strong>
    <%= settings.shop_prelaunch_notice %>
  </div>
<% } %>

<div class="product-detail">
  <div class="product-detail-image edge-soft">
    <% if (product.image) { %>
      <img src="<%= thumb(product.image, 960) %>" srcset="<%= srcset(product.image, [480, 640, 960, 1280]) %>" sizes="(max-width: 640px) 92vw, 480px" alt="<%= product.name %>">
    <% } else { %>
      <div class="no-image">Нет фото</div>
    <% } %>
  </div>
  <div class="product-detail-info">
    <h1><%= product.name %></h1>
    <p class="product-price"><%= priceLabel(product) %></p>
    <%# Описание набирают в textarea: пустая строка — новый абзац, одиночный перенос сохраняем %>
    <% (product.description || '').split(/\r?\n\s*\r?\n/).filter(function (p) { return p.trim(); }).forEach(function (para) { %>
      <p class="product-description"><% para.trim().split(/\r?\n/).forEach(function (line, i) { %><% if (i) { %><br><% } %><%- renderLinkedText(line) %><% }); %></p>
    <% }); %>

    <%# С чем связана вещь на сайте: раздел каталога, дроп, трек и релиз, из которого она выросла %>
    <%
      var linkCategory = locals.category || null;
      var linkCollection = locals.collection || null;
      var linkTrack = locals.track || null;
      var linkRelease = release && release.is_published && release.slug ? release : null;
    %>
    <% if (linkCategory || linkCollection || release) { %>
      <ul class="product-links">
        <% if (linkCategory) { %>
          <li>Раздел: <a href="/catalog?category=<%= encodeURIComponent(linkCategory.slug) %>"><%= linkCategory.name %></a></li>
        <% } %>
        <% if (linkCollection) { %>
          <li>Дроп: <a href="/drops/<%= linkCollection.slug %>"><%= linkCollection.name %></a></li>
        <% } %>
        <% if (linkTrack && linkRelease) { %>
          <li>К треку <a href="/music/<%= linkRelease.slug %>/<%= linkTrack.slug %>"><%= linkTrack.title %></a>
            из релиза <a href="/music/<%= linkRelease.slug %>"><%= linkRelease.title %> (<%= linkRelease.year %>)</a></li>
        <% } else if (linkRelease) { %>
          <li>К релизу <a href="/music/<%= linkRelease.slug %>"><%= linkRelease.title %> (<%= linkRelease.year %>)</a></li>
        <% } else if (release) { %>
          <li>К релизу <%= release.title %> (<%= release.year %>)</li>
        <% } %>
      </ul>
    <% } %>

    <%# Параметры показываем только заполненные — пустых строк в карточке быть не должно %>
    <% if (product.includes) { %>
      <div class="product-includes">
        <h2>Что входит</h2>
        <ul>
          <% product.includes.split(/\r?\n/).filter(function (l) { return l.trim(); }).forEach(function (line) { %>
            <li><%= line.trim() %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <%
      // Поля в базе общие для всех товаров, а подписи — нет. У файла нет
      // ни веса, ни материала, ни ухода: «Вес: 54 МБ» и «Материал:
      // цифровой архив» превращают карточку в недоразумение.
      const specLabels = product.is_digital
        ? ['Когда придёт', 'Размер', 'Объём файлов', 'Формат', 'Важно знать']
        : ['Срок изготовления', 'Размер', 'Вес', 'Материал', 'Уход'];
      const specs = [
        [specLabels[0], product.lead_time],
        [specLabels[1], product.dimensions],
        [specLabels[2], product.weight],
        [specLabels[3], product.material],
        [specLabels[4], product.care],
        // Изготовитель — обязательное сведение о товаре; у цифровых — правообладатель.
        [product.is_digital ? 'Правообладатель' : 'Изготовитель', product.manufacturer],
      ].filter(function (row) { return row[1]; });
    %>
    <% if (specs.length) { %>
      <table class="product-specs">
        <% specs.forEach(function (row) { %>
          <tr><th><%= row[0] %></th><td><%= row[1] %></td></tr>
        <% }); %>
      </table>
    <% } %>
    <% if (product.is_digital) { %>
      <p class="product-digital-note">
        <% if (Number(product.price) === 0) { %>
          Цифровой товар, бесплатно. Ссылка на скачивание придёт на почту
          и откроется сразу на экране — оплата не требуется.
        <% } else { %>
          Цифровой товар. После оплаты придёт ссылка на скачивание — на почту и сразу на экран.
        <% } %>
      </p>
      <% if (settings.ipex_showcase_url && /стемы|dj-верси/i.test(product.name)) { %>
        <p class="product-digital-note">Файлы — для личного использования, ремиксов и сетов. Для видео, рекламы и кино нужна лицензия — <a href="<%= settings.ipex_showcase_url %>" target="_blank" rel="noopener">каталог на IPEX</a>.</p>
      <% } %>
      <form action="/cart/add" method="POST">
        <input type="hidden" name="productId" value="<%= product.id %>">
        <button class="btn" type="submit"><%= Number(product.price) === 0 ? 'Забрать бесплатно' : 'Купить и скачать' %></button>
      </form>
    <% } else if (isMadeToOrder(product)) { %>
      <%# Вещь без цены: её считают под конкретный заказ — размер, тираж, материал.
          Кнопки «в корзину» здесь быть не должно, иначе вещь уедет за 0 ₽. %>
      <p class="product-made-to-order">Изготавливается под заказ</p>
      <p class="product-digital-note">
        Цену называем под ваш заказ: она зависит от размера, тиража и материала.
        Напишите нам — ответим ценой и сроком.
      </p>
      <a class="btn" href="/contact">Спросить цену</a>
    <% } else if (product.stock > 0 || product.fulfillment === 'printful') { %>
      <%# Точный остаток честен только там, где вещь лежит готовой. У нас всё
          отливается под заказ, и остаток в базе — заглушка «сколько угодно»:
          «в наличии 999 шт.» спорит и с шапкой каталога, и с описанием, где
          каждый экземпляр отливается отдельно. Признак изготовления под заказ —
          указанный срок; когда он указан, называем срок, а не количество. %>
      <% if (product.lead_time) { %>
        <p class="product-made-to-order">Изготавливается под заказ</p>
      <% } else { %>
        <% if (product.fulfillment !== 'printful') { %><p>В наличии: <%= product.stock %> шт.</p><% } %>
      <% } %>
      <form action="/cart/add" method="POST">
        <input type="hidden" name="productId" value="<%= product.id %>">
        <% const variants = product.fulfillment === 'printful' ? parseVariants(product.printful_variants) : []; %>
        <% if (variants.length) { %>
          <label>
            Размер:
            <select name="variant" required>
              <% variants.forEach(function (v) { %><option value="<%= v.label %>"><%= v.label %></option><% }); %>
            </select>
          </label>
        <% } %>
        <label>
          Количество:
          <input type="number" name="qty" value="1" min="1" <% if (product.fulfillment !== 'printful') { %>max="<%= Math.min(product.stock, 10) %>"<% } %>>
        </label>
        <button class="btn" type="submit">Добавить в корзину</button>
      </form>
      <% if (product.fulfillment === 'printful') { %>
        <p class="product-digital-note">Печатается под заказ после оплаты и отправляется почтой из типографии; доставка обычно 7–20 дней. Пункт выдачи для такой вещи недоступен.</p>
      <% } %>
    <% } else { %>
      <p class="out-of-stock">Товара нет в наличии</p>
    <% } %>
  </div>
</div>

<% if (typeof reviews !== 'undefined' && reviews.length) { %>
<div class="link-section product-reviews">
  <h2>Отзывы</h2>
  <%- include('partials/review-list', { list: reviews, showSubject: false }) %>
  <p class="hint">Отзывы — только от покупателей: ссылка на форму приходит вместе с заказом. <a href="/reviews">Все отзывы →</a></p>
</div>
<% } %>

<%- include('partials/share') %>

<%- include('partials/footer') %>
