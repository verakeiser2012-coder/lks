<%- include('partials/header') %>

<% if (settings.shop_prelaunch_notice) { %>
  <div class="prelaunch-notice">
    <strong>Магазин готовится к запуску.</strong>
    <%= settings.shop_prelaunch_notice %>
  </div>
<% } %>

<div class="product-detail">
  <div class="product-detail-image edge-soft">
    <% if (product.image) { %>
      <img src="<%= product.image %>" alt="<%= product.name %>">
    <% } else { %>
      <div class="no-image">Нет фото</div>
    <% } %>
  </div>
  <div class="product-detail-info">
    <h1><%= product.name %></h1>
    <p class="product-price"><%= formatPrice(product.price) %></p>
    <p><%= product.description %></p>
    <% if (release) { %>
      <p class="product-release-link">Из релиза: <a href="/music"><%= release.title %> (<%= release.year %>)</a></p>
    <% } %>

    <%# Параметры показываем только заполненные — пустых строк в карточке быть не должно %>
    <% if (product.includes) { %>
      <div class="product-includes">
        <h2>Что входит</h2>
        <ul>
          <% product.includes.split(/\r?\n/).filter(function (l) { return l.trim(); }).forEach(function (line) { %>
            <li><%= line.trim() %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <%
      // Поля в базе общие для всех товаров, а подписи — нет. У файла нет
      // ни веса, ни материала, ни ухода: «Вес: 54 МБ» и «Материал:
      // цифровой архив» превращают карточку в недоразумение.
      const specLabels = product.is_digital
        ? ['Когда придёт', 'Размер', 'Объём файлов', 'Формат', 'Важно знать']
        : ['Срок изготовления', 'Размер', 'Вес', 'Материал', 'Уход'];
      const specs = [
        [specLabels[0], product.lead_time],
        [specLabels[1], product.dimensions],
        [specLabels[2], product.weight],
        [specLabels[3], product.material],
        [specLabels[4], product.care],
      ].filter(function (row) { return row[1]; });
    %>
    <% if (specs.length) { %>
      <table class="product-specs">
        <% specs.forEach(function (row) { %>
          <tr><th><%= row[0] %></th><td><%= row[1] %></td></tr>
        <% }); %>
      </table>
    <% } %>
    <% if (product.is_digital) { %>
      <p class="product-digital-note">
        <% if (Number(product.price) === 0) { %>
          Цифровой товар, бесплатно. Ссылка на скачивание придёт на почту
          и откроется сразу на экране — оплата не требуется.
        <% } else { %>
          Цифровой товар. После оплаты придёт ссылка на скачивание — на почту и сразу на экран.
        <% } %>
      </p>
      <form action="/cart/add" method="POST">
        <input type="hidden" name="productId" value="<%= product.id %>">
        <button class="btn" type="submit"><%= Number(product.price) === 0 ? 'Забрать бесплатно' : 'Купить и скачать' %></button>
      </form>
    <% } else if (product.stock > 0) { %>
      <%# Точный остаток честен только там, где вещь лежит готовой. У нас всё
          отливается под заказ, и остаток в базе — заглушка «сколько угодно»:
          «в наличии 999 шт.» спорит и с шапкой каталога, и с описанием, где
          каждый экземпляр отливается отдельно. Признак изготовления под заказ —
          указанный срок; когда он указан, называем срок, а не количество. %>
      <% if (product.lead_time) { %>
        <p class="product-made-to-order">Изготавливается под заказ</p>
      <% } else { %>
        <p>В наличии: <%= product.stock %> шт.</p>
      <% } %>
      <form action="/cart/add" method="POST">
        <input type="hidden" name="productId" value="<%= product.id %>">
        <label>
          Количество:
          <input type="number" name="qty" value="1" min="1" max="<%= product.stock %>">
        </label>
        <button class="btn" type="submit">Добавить в корзину</button>
      </form>
    <% } else { %>
      <p class="out-of-stock">Товара нет в наличии</p>
    <% } %>
  </div>
</div>

<%- include('partials/share') %>

<%- include('partials/footer') %>
