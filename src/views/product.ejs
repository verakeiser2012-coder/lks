<%- include('partials/header') %>

<div class="product-detail">
  <div class="product-detail-image edge-soft">
    <% if (product.image) { %>
      <img src="<%= product.image %>" alt="<%= product.name %>">
    <% } else { %>
      <div class="no-image">Нет фото</div>
    <% } %>
  </div>
  <div class="product-detail-info">
    <h1><%= product.name %></h1>
    <p class="product-price"><%= product.price %> ₽</p>
    <p><%= product.description %></p>
    <% if (release) { %>
      <p class="product-release-link">Из релиза: <a href="/music"><%= release.title %> (<%= release.year %>)</a></p>
    <% } %>

    <%# Параметры показываем только заполненные — пустых строк в карточке быть не должно %>
    <% if (product.includes) { %>
      <div class="product-includes">
        <h2>Что входит</h2>
        <ul>
          <% product.includes.split(/\r?\n/).filter(function (l) { return l.trim(); }).forEach(function (line) { %>
            <li><%= line.trim() %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <%
      const specs = [
        ['Срок изготовления', product.lead_time],
        ['Размер', product.dimensions],
        ['Вес', product.weight],
        ['Материал', product.material],
        ['Уход', product.care],
      ].filter(function (row) { return row[1]; });
    %>
    <% if (specs.length) { %>
      <table class="product-specs">
        <% specs.forEach(function (row) { %>
          <tr><th><%= row[0] %></th><td><%= row[1] %></td></tr>
        <% }); %>
      </table>
    <% } %>
    <% if (product.is_digital) { %>
      <p class="product-digital-note">
        Цифровой товар. После оплаты придёт ссылка на скачивание — на почту и сразу на экран.
      </p>
      <form action="/cart/add" method="POST">
        <input type="hidden" name="productId" value="<%= product.id %>">
        <button class="btn" type="submit">Купить и скачать</button>
      </form>
    <% } else if (product.stock > 0) { %>
      <p>В наличии: <%= product.stock %> шт.</p>
      <form action="/cart/add" method="POST">
        <input type="hidden" name="productId" value="<%= product.id %>">
        <label>
          Количество:
          <input type="number" name="qty" value="1" min="1" max="<%= product.stock %>">
        </label>
        <button class="btn" type="submit">Добавить в корзину</button>
      </form>
    <% } else { %>
      <p class="out-of-stock">Товара нет в наличии</p>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
