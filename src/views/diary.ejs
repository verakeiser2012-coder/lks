<%- include('partials/header') %>

<h1>Дневник</h1>
<p class="hero-tagline" style="margin-top:-8px;">Личные истории и разборы по мотивам подкастов — дублируются в Дзен.</p>

<% (banners || []).forEach(function(banner) { %><%- include('partials/banner', { banner }) %><% }); %>

<% if (posts.length === 0) { %>
  <p>Записей пока нет.</p>
<% } else { %>
  <%# Та же лента, что в новостях: плитка или список, выбор помнится в браузере. %>
  <div class="news-view-toggle">
    <button type="button" id="view-grid" class="active">Плитка</button>
    <button type="button" id="view-rows">Список</button>
  </div>
  <div class="news-list" id="news-list">
    <% posts.forEach(function(post) { %>
      <a class="news-card" href="/diary/<%= post.slug %>">
        <div class="news-card-image">
          <% if (post.cover_image) { %>
            <img loading="lazy" decoding="async" src="<%= thumb(post.cover_image, 640) %>" srcset="<%= srcset(post.cover_image) %>" sizes="(max-width: 640px) 92vw, (max-width: 1000px) 46vw, 300px" alt="<%= post.title %>">
          <% } else { %>
            <div class="no-image">Нет фото</div>
          <% } %>
        </div>
        <div>
          <div class="news-date"><%= formatDate(post.created_at) %></div>
          <div class="news-title"><%= post.title %></div>
          <% if (post.excerpt) { %><p class="diary-excerpt"><%= post.excerpt %></p><% } %>
        </div>
      </a>
    <% }); %>
  </div>
<% } %>

<script>
  (function () {
    var list = document.getElementById('news-list');
    var btnGrid = document.getElementById('view-grid');
    var btnRows = document.getElementById('view-rows');
    if (!list) return;
    function apply(view) {
      list.classList.toggle('news-list--rows', view === 'rows');
      btnGrid.classList.toggle('active', view !== 'rows');
      btnRows.classList.toggle('active', view === 'rows');
      try { localStorage.setItem('diaryView', view); } catch (e) {}
    }
    btnGrid.addEventListener('click', function () { apply('grid'); });
    btnRows.addEventListener('click', function () { apply('rows'); });
    var saved = null;
    try { saved = localStorage.getItem('diaryView'); } catch (e) {}
    if (saved === 'rows') apply('rows');
  })();
</script>

<%- include('partials/footer') %>
