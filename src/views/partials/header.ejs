<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%
    const SECTION_TITLES = {
      news: 'Новости', diary: 'Дневник', about: 'Обо мне', music: 'Музыка DJ Levka', gigs: 'Выступления',
      style: 'Стиль', redheads: 'Рыжие, которые вдохновляют', contest: 'Конкурс',
      catalog: 'Каталог', drops: 'Дропы', brands: 'Брендам', cart: 'Корзина', checkout: 'Оформление заказа',
    };
    const siteBase = [settings.site_name, settings.site_alt_name].filter(Boolean).join(' — ') || 'Лев Кейсер';
    let docTitle;
    if (typeof title !== 'undefined' && title) {
      docTitle = title + ' — ' + siteBase;
    } else {
      const seg = (typeof currentPath === 'string' ? currentPath : '/').split('?')[0].replace(/^\/en(\/|$)/, '/').split('/')[1] || '';
      docTitle = SECTION_TITLES[seg]
        ? SECTION_TITLES[seg] + ' — ' + siteBase
        : [siteBase, settings.site_tagline].filter(Boolean).join(' — ');
    }
    const cleanPath = (typeof currentPath === 'string' ? currentPath : '/').split('?')[0];
    const canonicalUrl = (typeof canonicalBase === 'string' ? canonicalBase : '') + (cleanPath === '/' ? '' : cleanPath);
    const metaDesc = (typeof pageDescription !== 'undefined' && pageDescription)
      ? pageDescription
      : (settings.meta_description
        || [settings.site_tagline, 'Музыка DJ Levka, съёмки, выступления и мерч.'].filter(Boolean).join('. '));
    const ogImagePath = (typeof pageImage !== 'undefined' && pageImage) ? pageImage : (settings.og_image || '');
    const ogImageUrl = ogImagePath
      ? (ogImagePath.startsWith('http') ? ogImagePath : (typeof canonicalBase === 'string' ? canonicalBase : '') + ogImagePath)
      : '';
  %>
  <title><%= docTitle %></title>
  <meta name="description" content="<%= metaDesc %>">
  <link rel="canonical" href="<%= canonicalUrl %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= siteBase %>">
  <meta property="og:title" content="<%= docTitle %>">
  <meta property="og:description" content="<%= metaDesc %>">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta property="og:locale" content="ru_RU">
  <% if (ogImageUrl) { %>
    <meta property="og:image" content="<%= ogImageUrl %>">
    <meta name="twitter:card" content="summary_large_image">
  <% } else { %>
    <meta name="twitter:card" content="summary">
  <% } %>
  <meta name="twitter:title" content="<%= docTitle %>">
  <meta name="twitter:description" content="<%= metaDesc %>">
  <meta name="theme-color" content="#211A12">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@500;600;700;800&family=Marck+Script&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
  <% if (settings.metrika_id && /^\d+$/.test(settings.metrika_id)) { %>
  <!-- Yandex.Metrika counter -->
  <script type="text/javascript">
    (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
    m[i].l=1*new Date();
    for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
    k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
    (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
    ym(<%= settings.metrika_id %>, "init", { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: true });
  </script>
  <noscript><div><img src="https://mc.yandex.ru/watch/<%= settings.metrika_id %>" style="position:absolute; left:-9999px;" alt=""></div></noscript>
  <!-- /Yandex.Metrika counter -->
  <% } %>
</head>
<body>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <filter id="gold-emboss" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur in="SourceAlpha" stdDeviation="2.6" result="blur"/>
        <feDiffuseLighting in="blur" surfaceScale="7" diffuseConstant="1.15" lighting-color="#e0a418" result="diffuse">
          <fePointLight x="-4000" y="-9000" z="8000"/>
        </feDiffuseLighting>
        <feComposite in="diffuse" in2="SourceAlpha" operator="in" result="diffuseClipped"/>
        <feSpecularLighting in="blur" surfaceScale="7" specularConstant="1.4" specularExponent="22" lighting-color="#fffef2" result="spec">
          <fePointLight x="-4000" y="-9000" z="8000"/>
        </feSpecularLighting>
        <feComposite in="spec" in2="SourceAlpha" operator="in" result="specClipped"/>
        <feComposite in="specClipped" in2="diffuseClipped" operator="arithmetic" k1="0" k2="1" k3="1" k4="0"/>
      </filter>
    </defs>
  </svg>
  <a class="skip-link" href="#main">К содержанию</a>
  <header class="site-header">
    <div class="container header-top">
      <div class="logo">
        <span class="logo-names">
          <a class="logo-name" href="/">
            <%= settings.site_name %>
            <svg class="badge-icon" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="12" fill="currentColor"/>
              <path d="M7.5 12.5l2.7 2.7L16.5 9" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <% if (settings.site_alt_name) { %>
            <a class="logo-name" href="/music">
              <%= settings.site_alt_name %>
              <svg class="badge-icon" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="12" fill="currentColor"/>
                <path d="M7.5 12.5l2.7 2.7L16.5 9" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          <% } %>
        </span>
        <% if (settings.site_tagline) { %><span class="logo-tagline"><%= settings.site_tagline %></span><% } %>
      </div>
      <a class="header-mascots" href="/about" title="Двигаюсь медленно в быстром мире" aria-label="Двигаюсь медленно в быстром мире">
        <img class="hm-temp" src="/img/mascot-temp.svg" alt="" width="44" height="53" aria-hidden="true">
        <img class="hm-vasiliy" src="/img/mascot-vasiliy.svg" alt="" width="34" height="42" aria-hidden="true">
      </a>
      <div class="shop-nav">
        <%
          const shopPath = (typeof currentPath === 'string' ? currentPath : '/').split('?')[0];
          function shopActive(href) { return shopPath === href || shopPath.startsWith(href + '/') ? ' active' : ''; }
        %>
        <a href="/catalog" class="shop-link<%= shopActive('/catalog') %>">Каталог</a>
        <a href="/drops" class="shop-link<%= shopActive('/drops') %>">Дропы</a>
        <a href="/brands" class="shop-link<%= shopActive('/brands') %>">Брендам</a>
        <audio id="bg-audio" preload="none"></audio>
        <div class="bg-audio-widget">
          <a href="/music" class="bg-audio-link" aria-label="Перейти к музыке">
            <svg class="bg-audio-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 6v12l-5-4H2V10h2l5-4Z" fill="currentColor" stroke="none"/>
              <path d="M15.5 8.5a5 5 0 0 1 0 7"/>
              <path d="M18 6a8.5 8.5 0 0 1 0 12"/>
            </svg>
          </a>
          <button type="button" id="bg-audio-toggle" class="bg-audio-mute" aria-pressed="false" aria-label="Включить музыку">
            <svg class="bg-audio-mute-icon bg-audio-mute-icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" fill="currentColor" stroke="none"/>
            </svg>
            <svg class="bg-audio-mute-icon bg-audio-mute-icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 6l12 12M18 6 6 18"/>
            </svg>
          </button>
        </div>
        <form class="header-search" action="/search" method="GET" role="search">
          <input type="search" name="q" placeholder="Поиск" aria-label="Поиск по сайту" value="<%= typeof query !== 'undefined' ? query : '' %>">
          <button type="submit" aria-label="Найти">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
            </svg>
          </button>
        </form>
        <%
          // Английская версия пока есть только у новостей — переключатель показываем там,
          // чтобы не уводить на пустой раздел.
          const langPath = (typeof currentPath === 'string' ? currentPath : '/').split('?')[0];
          const isEn = langPath.startsWith('/en/');
          const ruPath = isEn ? langPath.replace(/^\/en/, '') : langPath;
          const hasEn = ruPath === '/news' || ruPath.startsWith('/news/');
        %>
        <% if (hasEn) { %>
          <div class="lang-switch">
            <a href="<%= ruPath %>" class="<%= isEn ? '' : 'active' %>" hreflang="ru">RU</a>
            <a href="/en<%= ruPath %>" class="<%= isEn ? 'active' : '' %>" hreflang="en">EN</a>
          </div>
        <% } %>
        <a href="/cart" class="cart-btn">
          <svg class="cart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
            <path d="M3 6h18"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          Корзина<% if (cartCount > 0) { %><span class="cart-badge"><%= cartCount %></span><% } %>
        </a>
        <button type="button" class="nav-toggle" aria-label="Меню" aria-expanded="false" aria-controls="site-nav-inner">
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
        </button>
      </div>
    </div>
    <%
      const navPath = (typeof currentPath === 'string' ? currentPath : '/').split('?')[0].replace(/^\/en(\/|$)/, '/');
      function navActive(href) {
        if (href === '/') return navPath === '/' ? 'active' : '';
        return navPath === href || navPath.startsWith(href + '/') ? 'active' : '';
      }
    %>
    <nav class="site-nav">
      <div class="container nav-inner" id="site-nav-inner">
        <a href="/" class="<%= navActive('/') %>">Главная</a>
        <a href="/news" class="<%= navActive('/news') %>">Новости</a>
        <a href="/diary" class="<%= navActive('/diary') %>">Дневник</a>
        <a href="/about" class="<%= navActive('/about') %>">Обо мне</a>
        <span class="nav-divider" aria-hidden="true"></span>
        <a href="/music" class="nav-music-link <%= navActive('/music') %>">DJ Levka</a>
        <a href="/gigs" class="<%= navActive('/gigs') %>">Выступления</a>
        <a href="/style" class="<%= navActive('/style') %>">Стиль</a>
        <a href="/redheads" class="<%= navActive('/redheads') %>">Рыжие</a>
        <a href="/contest" class="<%= navActive('/contest') %>">Конкурс</a>
      </div>
    </nav>
  </header>
  <main class="container" id="main">
