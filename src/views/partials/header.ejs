<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : [settings.site_name, settings.site_alt_name, settings.site_tagline].filter(Boolean).join(' — ') %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@500;600;700;800&family=Marck+Script&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <filter id="gold-emboss" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur in="SourceAlpha" stdDeviation="2.6" result="blur"/>
        <feDiffuseLighting in="blur" surfaceScale="7" diffuseConstant="1.15" lighting-color="#e0a418" result="diffuse">
          <fePointLight x="-4000" y="-9000" z="8000"/>
        </feDiffuseLighting>
        <feComposite in="diffuse" in2="SourceAlpha" operator="in" result="diffuseClipped"/>
        <feSpecularLighting in="blur" surfaceScale="7" specularConstant="1.4" specularExponent="22" lighting-color="#fffef2" result="spec">
          <fePointLight x="-4000" y="-9000" z="8000"/>
        </feSpecularLighting>
        <feComposite in="spec" in2="SourceAlpha" operator="in" result="specClipped"/>
        <feComposite in="specClipped" in2="diffuseClipped" operator="arithmetic" k1="0" k2="1" k3="1" k4="0"/>
      </filter>
    </defs>
  </svg>
  <header class="site-header">
    <div class="container header-top">
      <div class="logo">
        <span class="logo-names">
          <a class="logo-name" href="/">
            <%= settings.site_name %>
            <svg class="badge-icon" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="12" fill="currentColor"/>
              <path d="M7.5 12.5l2.7 2.7L16.5 9" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <% if (settings.site_alt_name) { %>
            <a class="logo-name" href="/music">
              <%= settings.site_alt_name %>
              <svg class="badge-icon" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="12" fill="currentColor"/>
                <path d="M7.5 12.5l2.7 2.7L16.5 9" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          <% } %>
        </span>
        <% if (settings.site_tagline) { %><span class="logo-tagline"><%= settings.site_tagline %></span><% } %>
      </div>
      <div class="shop-nav">
        <a href="/catalog" class="shop-link">Каталог</a>
        <a href="/drops" class="shop-link">Дропы</a>
        <a href="/brands" class="shop-link">Брендам</a>
        <a href="/cart" class="cart-btn">
          <svg class="cart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
            <path d="M3 6h18"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          Корзина<% if (cartCount > 0) { %><span class="cart-badge"><%= cartCount %></span><% } %>
        </a>
        <button type="button" class="nav-toggle" aria-label="Меню" aria-expanded="false" aria-controls="site-nav-inner">
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
        </button>
      </div>
    </div>
    <nav class="site-nav">
      <div class="container nav-inner" id="site-nav-inner">
        <a href="/">Главная</a>
        <a href="/news">Новости</a>
        <a href="/about">Обо мне</a>
        <span class="nav-divider" aria-hidden="true"></span>
        <a href="/music">Музыка</a>
        <a href="/gigs">Выступления</a>
        <a href="/style">Стиль</a>
        <a href="/redheads">Рыжие</a>
        <a href="/contest">Конкурс</a>
      </div>
    </nav>
  </header>
  <main class="container">
