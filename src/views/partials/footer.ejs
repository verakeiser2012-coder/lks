  </main>
  <%
    const icons = {
      youtube: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5.5" width="19" height="13" rx="3.5"/><path d="M10.5 9.5l5 2.5-5 2.5Z" fill="currentColor" stroke="none"/></svg>',
      tiktok: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v10.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.4 2.4 2.1 4.1 4.5 4.4"/></svg>',
      rutube: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5.5" width="19" height="13" rx="3.5"/><path d="M10.5 9.5l5 2.5-5 2.5Z" fill="currentColor" stroke="none"/></svg>',
      telegram: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 4 3 11.5l6 2m12-9.5-3.5 16-8.5-6.5m12-9.5-8.5 9.5"/></svg>',
      whatsapp: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l1.3-4A8 8 0 1 1 8.5 19L4 20Z"/><path d="M8.5 9.5c0 3.5 2.5 6 6 6l1-2-2.7-1.3-.8 1a5 5 0 0 1-3.2-3.2l1-.8L8.5 6.5l-2 1Z" fill="currentColor" stroke="none"/></svg>',
      instagram: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>',
      pinterest: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9.5"/><path d="M9.5 18c1-3 1.5-5.3 2-7.5.5-2 3.5-2 4 .3.3 1.5-.6 3.7-2.3 3.9-1 .1-1.8-.5-1.7-1.6"/></svg>',
      vk: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="2.5" width="19" height="19" rx="5"/><path d="M7 8c.3 4.5 2.5 7 6.5 7h.5v-2.6c1.6.2 2.8 1.3 3.3 2.6h2.2c-.6-2.2-2.1-3.5-3.1-4 1-.6 2.4-2 2.8-3.8h-2c-.5 1.7-1.9 3-2.9 3.2V9c0-.6-.4-1-1-1h-2v4.7C9.9 12.4 8.9 10.4 8.6 8H7Z" fill="currentColor" stroke="none"/></svg>',
      ok: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.2"/><path d="M8.7 13.2a6 6 0 0 0 6.6 0"/><path d="M10.3 15 8 20m5.7-5L16 20"/></svg>',
      dzen: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c0 5-4 9-9 9 5 0 9 4 9 9 0-5 4-9 9-9-5 0-9-4-9-9Z"/></svg>',
      douyin: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v10.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.4 2.4 2.1 4.1 4.5 4.4"/><path d="M11 8.5c.4 2.4 2.1 4.1 4.5 4.4" opacity="0.5"/></svg>',
      weibo: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 20c-3 0-5.5-1.7-5.5-4.3 0-3.1 3.3-6.7 7-6.7 3 0 5 1.7 5 3.9 0 3-3.3 7.1-6.5 7.1Z"/><circle cx="7.7" cy="15.8" r="1"/><path d="M16.5 5.5c2.5.3 4 2 3.8 4.2"/><path d="M15.8 8c1.3.1 2.1 1 2 2.3"/></svg>',
      wechat: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 3.5C5.9 3.5 3 6 3 9.2c0 1.8 1 3.4 2.5 4.5l-.6 2.3 2.4-1.2c.7.2 1.4.3 2.2.3h.4a5.8 5.8 0 0 1-.2-1.6c0-3.3 3.2-6 7.1-6h.3c-.8-2.4-3.6-4-6.6-4Z"/><path d="M21 14.2c0-2.5-2.4-4.5-5.5-4.5s-5.5 2-5.5 4.5 2.4 4.5 5.5 4.5c.6 0 1.2-.1 1.8-.2l2 1-.5-1.9c1.4-.9 2.2-2.1 2.2-3.4Z"/></svg>',
      xiaohongshu: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="3"/><path d="M8 8h5M8 12h8M8 16h5"/></svg>',
    };
    const musicSocial = [
      { key: 'youtube', label: 'YouTube', url: settings.youtube_url },
      { key: 'tiktok', label: 'TikTok', url: settings.tiktok_url },
      { key: 'rutube', label: 'Rutube', url: settings.rutube_url },
    ].filter(function (n) { return n.url; });
    const otherSocial = [
      { key: 'vk', label: 'VK', url: settings.vk_url },
      { key: 'telegram', label: 'Telegram', url: settings.telegram_url },
      { key: 'whatsapp', label: 'WhatsApp', url: settings.whatsapp_url },
      { key: 'instagram', label: 'Instagram', url: settings.instagram_url },
      { key: 'pinterest', label: 'Pinterest', url: settings.pinterest_url },
      { key: 'ok', label: 'Одноклассники', url: settings.ok_url },
      { key: 'dzen', label: 'Дзен', url: settings.dzen_url },
    ].filter(function (n) { return n.url; });
    const chinaSocial = [
      { key: 'douyin', label: 'Douyin', url: settings.douyin_url },
      { key: 'weibo', label: 'Weibo', url: settings.weibo_url },
      { key: 'wechat', label: 'WeChat', url: settings.wechat_url },
      { key: 'xiaohongshu', label: 'Xiaohongshu', url: settings.xiaohongshu_url },
    ].filter(function (n) { return n.url; });
  %>
  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <strong><%= settings.site_name %></strong>
        <% if (settings.site_alt_name || true) { %><span class="footer-alt">DJ Levka</span><% } %>
        <% if (settings.address) { %><p><%= settings.address %></p><% } %>
        <p class="footer-contacts">
          <% if (settings.phone) { %><a href="tel:<%= settings.phone.replace(/[^+\d]/g, '') %>"><%= settings.phone %></a><br><% } %>
          <a href="mailto:info@levkeiser.com">info@levkeiser.com</a> — общие вопросы<br>
          <a href="mailto:brand@levkeiser.com">brand@levkeiser.com</a> — сотрудничество<br>
          <a href="mailto:booking@levkeiser.com">booking@levkeiser.com</a> — выступления
        </p>
        <a class="footer-mediakit" href="/brands/media-kit">Медиа-кит для брендов →</a>
      </div>

      <nav class="footer-nav" aria-label="Разделы сайта">
        <h4>Разделы</h4>
        <a href="/news">Новости</a>
        <a href="/music">Музыка DJ Levka</a>
        <a href="/about">Обо мне</a>
        <a href="/style">Стиль</a>
        <a href="/gigs">Выступления</a>
        <a href="/redheads">Рыжие</a>
        <a href="/catalog">Каталог</a>
        <a href="/drops">Дропы</a>
      </nav>

      <div class="footer-subscribe">
        <h4>Будьте в курсе</h4>
        <p>Новые треки, релизы и дропы — на почту, без спама.</p>
        <% if (typeof subscribeSuccess !== 'undefined' && subscribeSuccess) { %><div class="flash flash-success">Готово, вы подписаны!</div><% } %>
        <% if (typeof subscribeError !== 'undefined' && subscribeError) { %><div class="flash flash-error"><%= subscribeError %></div><% } %>
        <form class="subscribe-form" action="/subscribe" method="POST">
  <input type="text" name="website" value="" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;" aria-hidden="true">
          <input type="hidden" name="redirectTo" value="<%= typeof currentPath !== 'undefined' ? currentPath : '/' %>">
          <input type="email" name="email" placeholder="you@email.com" required>
          <button class="btn" type="submit">Подписаться</button>
          <label style="display:flex; align-items:flex-start; gap:6px; width:100%; font-size:0.78rem; color:var(--color-muted);">
            <input type="checkbox" name="dataConsent" value="1" style="width:auto; margin-top:3px;" required>
            <span>Согласен на обработку email в соответствии с <a href="/legal/privacy">политикой конфиденциальности</a></span>
          </label>
        </form>
      </div>

      <div class="footer-social-groups">
        <% if (musicSocial.length) { %>
          <div class="social-group">
            <h4>Музыка</h4>
            <div class="social-icons">
              <% musicSocial.forEach(function (net) { %>
                <a href="<%= net.url %>" target="_blank" rel="noopener" title="<%= net.label %>" aria-label="<%= net.label %>" class="social-icon"><%- icons[net.key] %></a>
              <% }); %>
            </div>
          </div>
        <% } %>
        <% if (otherSocial.length) { %>
          <div class="social-group">
            <h4>Остальное</h4>
            <div class="social-icons">
              <% otherSocial.forEach(function (net) { %>
                <a href="<%= net.url %>" target="_blank" rel="noopener" title="<%= net.label %>" aria-label="<%= net.label %>" class="social-icon"><%- icons[net.key] %></a>
              <% }); %>
            </div>
          </div>
        <% } %>
        <% if (chinaSocial.length) { %>
          <div class="social-group">
            <h4>Китай</h4>
            <div class="social-icons">
              <% chinaSocial.forEach(function (net) { %>
                <a href="<%= net.url %>" target="_blank" rel="noopener" title="<%= net.label %>" aria-label="<%= net.label %>" class="social-icon"><%- icons[net.key] %></a>
              <% }); %>
            </div>
          </div>
        <% } %>
      </div>

      <div class="footer-legal">
        <a href="/legal/oferta">Публичная оферта</a>
        <a href="/legal/privacy">Персональные данные</a>
        <a href="/legal/delivery">Доставка</a>
        <a href="/legal/returns">Возврат и обмен</a>
      </div>

      <div class="footer-bottom">
        <span>© <%= new Date().getFullYear() %> <%= settings.site_name %></span>
        <% if (settings.legal_ip_name) { %>
          <span><%= settings.legal_ip_name %><% if (settings.legal_ogrnip) { %>, ОГРНИП <%= settings.legal_ogrnip %><% } %></span>
        <% } %>
        <span>Музыка и материалы сайта защищены авторским правом</span>
      </div>
    </div>
  </footer>
  <script src="/js/lightbox.js" defer></script>
  <script src="/js/nav.js" defer></script>
  <script src="/js/protect.js" defer></script>
  <button type="button" class="to-top" id="to-top" aria-label="Наверх">↑</button>
  <script>
    (function () {
      var btn = document.getElementById('to-top');
      if (!btn) return;
      function onScroll() {
        btn.classList.toggle('visible', window.scrollY > 600);
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      btn.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
      onScroll();
    })();
  </script>
  <script src="/js/bg-music.js" defer></script>
</body>
</html>
