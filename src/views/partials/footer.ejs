  </main>
  <%
    // Иконки — фирменные знаки из utils/socialIcons. Площадка сопоставляется
    // со знаком по подписи из page_links, откуда берёт список и раздел /music.
    const icons = socialIcons;
    const BY_LABEL = {
      'Spotify': 'spotify', 'Apple Music': 'apple-music', 'YouTube Music': 'youtube-music',
      'Яндекс Музыка': 'yandex-music', 'VK Музыка': 'vk', 'Zvuk': 'zvuk', 'Deezer': 'deezer',
      'SoundCloud': 'soundcloud', 'Bandcamp': 'bandcamp', 'TIDAL': 'tidal',
      'X (Twitter)': 'x', 'Facebook': 'facebook',
    };
    const links = (typeof musicLinks !== 'undefined' ? musicLinks : []);
    const pick = function (group, labels) {
      return labels.map(function (l) {
        const r = links.find(function (x) { return x.group_name === group && x.label === l; });
        return r ? { key: BY_LABEL[l], label: l, url: r.url } : null;
      }).filter(Boolean);
    };
    // Стриминги в порядке, в котором их ищут: сначала мировые, потом российские.
    const streaming = pick('Площадки', ['Spotify', 'Apple Music', 'YouTube Music', 'Яндекс Музыка', 'VK Музыка', 'Zvuk', 'Deezer', 'SoundCloud', 'Bandcamp', 'TIDAL']);
    const videoSocial = [
      { key: 'youtube', label: 'YouTube', url: settings.youtube_url },
      { key: 'tiktok', label: 'TikTok', url: settings.tiktok_url },
      { key: 'rutube', label: 'Rutube', url: settings.rutube_url },
    ].filter(function (n) { return n.url; });
    const otherSocial = [
      { key: 'vk', label: 'VK', url: settings.vk_url },
      { key: 'telegram', label: 'Telegram', url: settings.telegram_url },
      { key: 'whatsapp', label: 'WhatsApp', url: settings.whatsapp_url },
      { key: 'instagram', label: 'Instagram', url: settings.instagram_url },
      { key: 'pinterest', label: 'Pinterest', url: settings.pinterest_url },
      { key: 'ok', label: 'Одноклассники', url: settings.ok_url },
      { key: 'dzen', label: 'Дзен', url: settings.dzen_url },
    ].concat(pick('Соцсети', ['X (Twitter)', 'Facebook'])).filter(function (n) { return n.url; });
    const chinaSocial = [
      { key: 'douyin', label: 'Douyin', url: settings.douyin_url },
      { key: 'weibo', label: 'Weibo', url: settings.weibo_url },
      { key: 'wechat', label: 'WeChat', url: settings.wechat_url },
      { key: 'xiaohongshu', label: 'Xiaohongshu', url: settings.xiaohongshu_url },
    ].filter(function (n) { return n.url; });
  %>
  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <strong><%= settings.site_name %></strong>
        <% if (settings.site_alt_name || true) { %><span class="footer-alt">DJ Levka</span><% } %>
        <% if (settings.address) { %><p><%= settings.address %></p><% } %>
        <% if (settings.phone) { %>
          <p class="footer-contacts"><a href="tel:<%= settings.phone.replace(/[^+\d]/g, '') %>"><%= settings.phone %></a></p>
        <% } %>
        <details class="footer-mail">
          <summary>Почта</summary>
          <p class="footer-contacts">
            <a href="mailto:info@levkeiser.com">info@levkeiser.com</a> — общие вопросы<br>
            <a href="mailto:brand@levkeiser.com">brand@levkeiser.com</a> — сотрудничество<br>
            <a href="mailto:booking@levkeiser.com">booking@levkeiser.com</a> — выступления
          </p>
        </details>
        <a class="footer-mediakit" href="/brands/media-kit">Медиа-кит для брендов →</a>
      </div>

      <nav class="footer-nav" aria-label="Разделы сайта">
        <h4>Разделы</h4>
        <a href="/news">Новости</a>
        <a href="/music">Музыка DJ Levka</a>
        <a href="/about">Обо мне</a>
        <a href="/style">Стиль</a>
        <a href="/gigs">Выступления</a>
        <a href="/redheads">Рыжие</a>
        <a href="/catalog">Каталог</a>
        <a href="/drops">Дропы</a>
      </nav>

      <div class="footer-subscribe">
        <h4>Будьте в курсе</h4>
        <p>Новые треки, релизы и дропы — на почту, без спама.</p>
        <% if (typeof subscribeSuccess !== 'undefined' && subscribeSuccess) { %><div class="flash flash-success">Готово, вы подписаны!</div><% } %>
        <% if (typeof subscribeError !== 'undefined' && subscribeError) { %><div class="flash flash-error"><%= subscribeError %></div><% } %>
        <form class="subscribe-form" action="/subscribe" method="POST">
  <input type="text" name="website" value="" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;" aria-hidden="true">
          <input type="hidden" name="redirectTo" value="<%= typeof currentPath !== 'undefined' ? currentPath : '/' %>">
          <input type="email" name="email" placeholder="you@email.com" required>
          <button class="btn" type="submit">Подписаться</button>
          <label style="display:flex; align-items:flex-start; gap:6px; width:100%; font-size:0.78rem; color:var(--color-muted);">
            <input type="checkbox" name="dataConsent" value="1" style="width:auto; margin-top:3px;" required>
            <span>Согласен на обработку email в соответствии с <a href="/legal/privacy">политикой конфиденциальности</a></span>
          </label>
        </form>
      </div>

      <div class="footer-social-groups">
        <% if (streaming.length) { %>
          <div class="social-group">
            <h4>Музыка</h4>
            <div class="social-icons">
              <% streaming.forEach(function (net) { %>
                <a href="<%= net.url %>" target="_blank" rel="noopener" title="<%= net.label %>" aria-label="<%= net.label %>" class="social-icon"><%- icons[net.key] %></a>
              <% }); %>
            </div>
          </div>
        <% } %>
        <% if (videoSocial.length) { %>
          <div class="social-group">
            <h4>Видео</h4>
            <div class="social-icons">
              <% videoSocial.forEach(function (net) { %>
                <a href="<%= net.url %>" target="_blank" rel="noopener" title="<%= net.label %>" aria-label="<%= net.label %>" class="social-icon"><%- icons[net.key] %></a>
              <% }); %>
            </div>
          </div>
        <% } %>
        <% if (otherSocial.length) { %>
          <div class="social-group">
            <h4>Остальное</h4>
            <div class="social-icons">
              <% otherSocial.forEach(function (net) { %>
                <a href="<%= net.url %>" target="_blank" rel="noopener" title="<%= net.label %>" aria-label="<%= net.label %>" class="social-icon"><%- icons[net.key] %></a>
              <% }); %>
            </div>
          </div>
        <% } %>
        <% if (chinaSocial.length) { %>
          <div class="social-group">
            <h4>Китай</h4>
            <div class="social-icons">
              <% chinaSocial.forEach(function (net) { %>
                <a href="<%= net.url %>" target="_blank" rel="noopener" title="<%= net.label %>" aria-label="<%= net.label %>" class="social-icon"><%- icons[net.key] %></a>
              <% }); %>
            </div>
          </div>
        <% } %>
      </div>

      <div class="footer-legal">
        <a href="/legal/oferta">Публичная оферта</a>
        <a href="/legal/privacy">Персональные данные</a>
        <a href="/legal/payment">Оплата</a>
        <a href="/legal/delivery">Доставка</a>
        <a href="/legal/returns">Возврат и обмен</a>
      </div>

      <div class="footer-bottom">
        <span>© <%= new Date().getFullYear() %> <%= settings.site_name %></span>
        <% if (settings.legal_ip_name) { %>
          <span><%= settings.legal_ip_name %><% if (settings.legal_ogrnip) { %>, ОГРНИП <%= settings.legal_ogrnip %><% } %></span>
        <% } %>
        <span>Музыка и материалы сайта защищены авторским правом</span>
      </div>
    </div>
  </footer>
  <script src="/js/lightbox.js" defer></script>
  <script src="/js/nav.js" defer></script>
  <script src="/js/typewriter.js" defer></script>
  <script src="/js/protect.js" defer></script>
  <button type="button" class="to-top" id="to-top" aria-label="Наверх">↑</button>
  <script>
    (function () {
      var btn = document.getElementById('to-top');
      if (!btn) return;
      function onScroll() {
        btn.classList.toggle('visible', window.scrollY > 600);
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      btn.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
      onScroll();
    })();
  </script>
  <script src="/js/bg-music.js" defer></script>
  <script src="/js/cookie-consent.js" defer></script>
</body>
</html>
