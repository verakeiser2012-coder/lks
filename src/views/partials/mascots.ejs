<%
  /* Дуэт маскотов: Лев Темп («медленная сила») и кот Василий («живая спешка»).
     Ожидает локальную переменную mascotLine — реплику под картинкой (может быть пустой). */
  var line = typeof mascotLine === 'undefined' ? '' : mascotLine;
%>
<div class="mascot-duo">
  <img class="mascot-temp" src="/img/mascot-temp.svg" alt="Лев Темп" width="84" height="101">
  <img class="mascot-vasiliy" src="/img/mascot-vasiliy.svg" alt="Кот Василий" width="64" height="78">
</div>
<% if (line) { %><p class="mascot-line"><%- line %></p><% } %>
