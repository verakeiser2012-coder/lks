<%- include('partials/header') %>

<article>
  <div class="news-date"><%= post.created_at %></div>
  <h1><%= post.title %></h1>
  <div class="prose"><%- renderLinkedText(post.content) %></div>

  <% if (media.length > 0) { %>
    <div class="gallery-grid">
      <% media.forEach(function(item) { %>
        <div class="gallery-item <%= item.type === 'video' ? 'is-video' : '' %>">
          <% if (item.type === 'photo') { %>
            <img src="<%= item.file_path %>" alt="" loading="lazy">
          <% } else { %>
            <video src="<%= item.file_path %>" muted loop playsinline preload="metadata"></video>
          <% } %>
        </div>
      <% }); %>
    </div>
  <% } %>
</article>

<p>
  <% if (post.lang === 'en') { %>
    <a href="/en/news">← Back to news</a>
  <% } else { %>
    <a href="/news">← Ко всем новостям</a>
  <% } %>
</p>

<%- include('partials/footer') %>
