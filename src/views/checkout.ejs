<%- include('partials/header') %>

<h1>Оформление заказа</h1>

<% if (error) { %>
  <div class="flash flash-error"><%= error %></div>
<% } %>

<div class="catalog-layout">
  <div class="catalog-main">
    <form action="/checkout" method="POST">
      <label>
        Имя *
        <input type="text" name="customerName" required>
      </label>
      <label>
        Телефон *
        <input type="tel" name="phone" required>
      </label>
      <label>
        Email <%= digitalOnly ? '*' : '' %>
        <input type="email" name="email" <%= digitalOnly ? 'required' : '' %>>
      </label>
      <% if (digitalOnly) { %>
      <p style="color:var(--color-muted); font-size:0.85rem; margin:-8px 0 16px;">
        <%= hasService ? 'На эту почту придут подтверждение заказа и результат работы. Доставка не нужна.' : 'На эту почту придут ссылки на файлы. Доставка не нужна — заказ цифровой.' %>
      </p>
      <% } else if (needsPrintful) { %>
      <p style="color:var(--color-muted); font-size:0.85rem; margin:-8px 0 16px;">
        В заказе вещь, которая печатается под заказ: она отправляется почтой из типографии,
        поэтому нужен адрес по полям. Доставка обычно 7–20 дней.
      </p>
      <label>
        Страна *
        <input type="text" name="country" required placeholder="Россия">
      </label>
      <label>
        Город *
        <input type="text" name="city" required>
      </label>
      <label>
        Индекс *
        <input type="text" name="zip" required>
      </label>
      <label>
        Улица, дом, квартира *
        <input type="text" name="address" required>
      </label>
      <% } else { %>
      <fieldset style="border:1px solid var(--color-border); border-radius:var(--radius); padding:12px 14px; margin:0 0 16px;">
        <legend style="padding:0 6px;">Способ получения</legend>
        <label style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
          <input type="radio" name="deliveryMethod" value="courier" checked style="width:auto;" onchange="document.getElementById('delivery-address-field').style.display='';document.getElementById('delivery-pickup-field').style.display='none';">
          <span>Курьер / почта — на адрес</span>
        </label>
        <label style="display:flex; align-items:center; gap:8px;">
          <input type="radio" name="deliveryMethod" value="pickup" style="width:auto;" onchange="document.getElementById('delivery-address-field').style.display='none';document.getElementById('delivery-pickup-field').style.display='';">
          <span>Пункт выдачи (СДЭК, Boxberry, 5Post и т.п.)</span>
        </label>
      </fieldset>
      <%# Город и индекс нужны обоим способам: по ним считается доставка (СДЭК). %>
      <div class="checkout-city-row">
        <label>
          Город
          <input type="text" name="city" id="ship-city" placeholder="Екатеринбург">
        </label>
        <label>
          Индекс
          <input type="text" name="zip" id="ship-zip" inputmode="numeric" placeholder="620000">
        </label>
      </div>
      <% if (carriers && carriers.length) { %>
        <%# Живой расчёт: варианты «до двери» / «до пункта выдачи» подставляются скриптом ниже. %>
        <div id="shipping-quote" class="shipping-quote" hidden>
          <div class="shipping-quote-title">Доставка</div>
          <div id="shipping-options"></div>
          <p class="hint" id="shipping-hint" style="margin:6px 0 0;"></p>
        </div>
        <p class="hint" id="shipping-status" style="margin:-6px 0 14px;">Введите индекс или город — посчитаем доставку.</p>
      <% } %>
      <div id="delivery-address-field">
        <label>
          Адрес доставки (улица, дом, квартира)
          <input type="text" name="address">
        </label>
      </div>
      <div id="delivery-pickup-field" style="display:none;">
        <%# Пункт выдачи из списка СДЭК по городу/индексу (GET /checkout/pickup-points).
            Пока списка нет или служба не подключена — обычное текстовое поле. %>
        <label>
          Пункт выдачи
          <input type="text" id="pickup-search" placeholder="Начните вводить улицу — найдём пункт" autocomplete="off" hidden>
          <input type="text" name="pickupPoint" id="pickup-text" placeholder="Например: СДЭК на ул. Ленина, 10">
          <input type="hidden" name="pickupCode" id="pickup-code">
        </label>
        <div id="pickup-list" class="pickup-list" hidden></div>
        <p class="hint" id="pickup-status" style="margin:-8px 0 14px;">Введите город или индекс выше — покажем пункты выдачи.</p>
      </div>
      <% } %>
      <% if (hasService) { %>
      <%# Услуга делается по ссылкам покупателя, поэтому комментарий здесь — не «пожелания», а задание. %>
      <label>
        Ссылки на ваши релизы и соцсети, что уже оформлено *
        <textarea name="comment" rows="5" required placeholder="Ссылки на стриминги или band.link, ВК/Telegram, есть ли кабинет правообладателя, РАО, дистрибьютор"></textarea>
      </label>
      <label style="display:flex; align-items:flex-start; gap:8px;">
        <input type="checkbox" name="digitalConsent" value="1" style="width:auto; margin-top:4px;" required>
        <span>Согласен, что работа начинается сразу после оплаты. Отказаться можно, пока она не начата — напишите нам; результат приходит письмом *</span>
      </label>
      <% } else { %>
      <label>
        Комментарий к заказу
        <textarea name="comment" rows="3"></textarea>
      </label>
      <% } %>
      <% if (digitalOnly && !hasService) { %>
      <label style="display:flex; align-items:flex-start; gap:8px;">
        <input type="checkbox" name="digitalConsent" value="1" style="width:auto; margin-top:4px;" required>
        <span>Согласен получить доступ к файлам сразу после <%= total === 0 ? 'оформления' : 'оплаты' %> и понимаю, что после
        открытия доступа отказ от цифрового товара надлежащего качества не производится *</span>
      </label>
      <% } %>
      <label style="display:flex; align-items:flex-start; gap:8px;">
        <input type="checkbox" name="dataConsent" value="1" style="width:auto; margin-top:4px;" required>
        <span>Принимаю условия <a href="/legal/oferta" target="_blank" rel="noopener">публичной оферты</a>
        и даю согласие на обработку персональных данных в соответствии с
        <a href="/legal/privacy" target="_blank" rel="noopener">политикой конфиденциальности</a> *</span>
      </label>
      <%# Бесплатный заказ платить нечем: кнопка «Перейти к оплате» над «Итого:
          Бесплатно» выглядела бы ловушкой. Называем действие тем, что случится. %>
      <button class="btn" type="submit"><%= total === 0 ? 'Получить файлы' : 'Перейти к оплате' %></button>
    </form>
  </div>

  <aside class="category-filter">
    <h3>Ваш заказ</h3>
    <ul>
      <% items.forEach(function(item) { %>
        <li><%= item.product.name %> × <%= item.qty %> — <%= formatPrice(item.subtotal) %></li>
      <% }); %>
    </ul>
    <p><strong>Итого: <span id="checkout-total"><%= formatPrice(total) %></span></strong></p>
  </aside>
</div>

<% if (!digitalOnly && !needsPrintful && carriers && carriers.length) { %>
<script>
  // Расчёт доставки при вводе индекса/города: POST /checkout/quote → варианты с ценой
  // и сроком; выбранный вариант уходит с формой в shippingChoice и пересчитывается сервером.
  (function () {
    var city = document.getElementById('ship-city');
    var phoneEl = document.querySelector('input[name="phone"]');
    var zip = document.getElementById('ship-zip');
    var box = document.getElementById('shipping-quote');
    var opts = document.getElementById('shipping-options');
    var status = document.getElementById('shipping-status');
    var hint = document.getElementById('shipping-hint');
    var total = <%= Number(total) %>;
    var totalEl = document.getElementById('checkout-total');
    var timer = null, seq = 0;
    function methodRadio() { return document.querySelector('input[name="deliveryMethod"]:checked'); }
    function fmt(n) { return new Intl.NumberFormat('ru-RU').format(n) + ' ₽'; }
    function render(quotes) {
      opts.innerHTML = '';
      var any = false;
      quotes.forEach(function (q) {
        if (q.error) return;
        [['door', 'до двери'], ['pickup', 'до пункта выдачи']].forEach(function (pair) {
          var t = q[pair[0]]; if (!t) return;
          any = true;
          var id = 'ship-' + q.key + '-' + pair[0];
          var label = document.createElement('label');
          label.className = 'shipping-option';
          label.innerHTML = '<input type="radio" name="shippingChoice" value="' + q.key + ':' + pair[0] + '" id="' + id + '" data-price="' + Number(t.price) + '">'
            + '<span class="shipping-option-name">' + q.label + ' — ' + pair[1] + '</span>'
            + '<span class="shipping-option-meta">' + fmt(t.price) + ' · ' + t.days + ' дн.</span>';
          opts.appendChild(label);
        });
      });
      box.hidden = !any;
      status.hidden = any;
      if (!any) { status.textContent = 'Доставку в этот город посчитать не удалось — стоимость согласуем после оформления.'; return; }
      var preferred = (methodRadio() && methodRadio().value === 'pickup') ? 'pickup' : 'door';
      var first = opts.querySelector('input[value$=":' + preferred + '"]') || opts.querySelector('input');
      if (first) { first.checked = true; sync(); }
      opts.addEventListener('change', sync);
    }
    function sync() {
      var r = opts.querySelector('input[name="shippingChoice"]:checked');
      if (!r) return;
      var isPickup = /:pickup$/.test(r.value);
      var radio = document.querySelector('input[name="deliveryMethod"][value="' + (isPickup ? 'pickup' : 'courier') + '"]');
      if (radio && !radio.checked) { radio.checked = true; radio.dispatchEvent(new Event('change')); }
      // Список пунктов — той службы, чей вариант выбран: у СДЭК и Ozon они разные.
      var carrier = r.value.split(':')[0];
      if (isPickup && carrier !== pointsCarrier) { pointsCarrier = carrier; loadPoints(); }
      var price = Number(r.getAttribute('data-price')) || 0;
      hint.textContent = 'Итого с доставкой: ' + fmt(total + price) + '. Доставка оплачивается вместе с заказом.';
      if (totalEl) totalEl.textContent = fmt(total + price);
    }
    function refresh() {
      var c = city.value.trim(), z = zip.value.replace(/\D/g, '');
      if (!c && z.length < 6) { box.hidden = true; status.hidden = false; status.textContent = 'Введите индекс или город — посчитаем доставку.'; if (totalEl) totalEl.textContent = fmt(total); return; }
      var my = ++seq;
      status.hidden = false; status.textContent = 'Считаем доставку…';
      fetch('/checkout/quote', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ city: c, postcode: z, phone: phoneEl ? phoneEl.value : '' }) })
        .then(function (r) { return r.json(); })
        .then(function (d) { if (my === seq) render(d.quotes || []); })
        .catch(function () { if (my === seq) { status.textContent = 'Не удалось посчитать доставку — согласуем после оформления.'; } });
    }
    [city, zip].forEach(function (el) { el.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(refresh, 600); clearTimeout(ptimer); ptimer = setTimeout(loadPoints, 700); }); });
    // Ozon считает только покупателям с аккаунтом Ozon на этот телефон — пересчёт при смене номера.
    if (phoneEl) phoneEl.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(refresh, 800); });

    // Пункты выдачи: список по городу/индексу, фильтр по адресу, выбор — в скрытое поле.
    var search = document.getElementById('pickup-search');
    var ptext = document.getElementById('pickup-text');
    var pcode = document.getElementById('pickup-code');
    var plist = document.getElementById('pickup-list');
    var pstatus = document.getElementById('pickup-status');
    var points = [], ptimer = null, pseq = 0, pointsCarrier = 'cdek';
    var carrierNames = { cdek: 'СДЭК', ozon: 'Ozon' };
    function renderPoints() {
      var q = search.value.trim().toLowerCase();
      var shown = points.filter(function (p) { return !q || (p.address + ' ' + p.landmark).toLowerCase().indexOf(q) !== -1; }).slice(0, 40);
      plist.innerHTML = '';
      shown.forEach(function (p) {
        var b = document.createElement('button');
        b.type = 'button'; b.className = 'pickup-item' + (pcode.value === p.code ? ' is-selected' : '');
        b.innerHTML = '<span class="pickup-item-address">' + p.address + '</span>'
          + '<span class="pickup-item-meta">' + p.type + (p.hours ? ' · ' + p.hours : '') + (p.landmark ? ' · ' + p.landmark : '') + (p.fitting ? ' · примерка' : '') + '</span>';
        b.addEventListener('click', function () {
          pcode.value = p.code; ptext.value = p.address + (p.city ? ' (' + p.city + ')' : '');
          search.value = p.address; renderPoints();
          pstatus.textContent = 'Выбран: ' + p.type + ', ' + p.address + '.';
        });
        plist.appendChild(b);
      });
      plist.hidden = shown.length === 0;
      if (points.length && !shown.length) pstatus.textContent = 'По такому адресу пунктов нет — попробуйте другую улицу.';
    }
    function loadPoints() {
      var c = city.value.trim(), z = zip.value.replace(/\D/g, '');
      points = []; pcode.value = ''; plist.hidden = true;
      if (!c && z.length < 6) { search.hidden = true; ptext.hidden = false; pstatus.textContent = 'Введите город или индекс выше — покажем пункты выдачи.'; return; }
      var my = ++pseq;
      pstatus.textContent = 'Ищем пункты выдачи…';
      fetch('/checkout/pickup-points?carrier=' + pointsCarrier + '&city=' + encodeURIComponent(c) + '&postcode=' + z)
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (my !== pseq) return;
          points = d.points || [];
          if (!points.length) { search.hidden = true; ptext.hidden = false; pstatus.textContent = 'Список пунктов не нашли — напишите удобный пункт словами, уточним после оформления.'; return; }
          search.hidden = false; ptext.hidden = true; ptext.value = '';
          pstatus.textContent = 'Пунктов выдачи ' + (carrierNames[pointsCarrier] || pointsCarrier) + ': ' + points.length + '. Выберите из списка или начните вводить улицу.';
          renderPoints();
        })
        .catch(function () { if (my === pseq) { search.hidden = true; ptext.hidden = false; pstatus.textContent = 'Список пунктов не загрузился — напишите удобный пункт словами.'; } });
    }
    search.addEventListener('input', function () { pcode.value = ''; ptext.value = ''; renderPoints(); });
    search.addEventListener('focus', function () { if (points.length) renderPoints(); });
    document.querySelectorAll('input[name="deliveryMethod"]').forEach(function (r) {
      r.addEventListener('change', function () {
        var want = r.value === 'pickup' ? 'pickup' : 'door';
        var o = opts.querySelector('input[value$=":' + want + '"]');
        if (o && !o.checked) { o.checked = true; sync(); }
      });
    });
  })();
</script>
<% } %>

<%- include('partials/footer') %>
