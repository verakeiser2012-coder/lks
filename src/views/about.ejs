<%- include('partials/header') %>

<h1>Обо мне</h1>

<div class="prose"><%- renderLinkedText(aboutText) %></div>

<% if (media.length > 0) { %>
  <div class="filmstrip"><div class="filmstrip-track">
    <% media.forEach(function(item, idx) { %>
      <% var dA = item.shot_date || item.created_at || ''; var markA = dA ? ' · ' + formatDateShort(dA, 'ru').toUpperCase() : ''; %>
      <div class="film-cell" data-code="LEVKEYSER · 35 MM" data-num="КАДР <%= String(idx + 1).padStart(2, '0') %><%= markA %>">
      <div class="gallery-item <%= item.type === 'video' ? 'is-video' : '' %>">
        <% if (item.type === 'photo') { %>
          <img src="<%= thumb(item.file_path, 640) %>" alt="<%= item.title %>" loading="lazy">
        <% } else { %>
          <video src="<%= item.file_path %>" muted loop playsinline preload="metadata"></video>
        <% } %>
        <% if (item.title) { %><div class="gallery-caption"><%= item.title %></div><% } %>
      </div>
      </div>
    <% }); %>
  </div></div>
<% } %>

<section class="link-section" id="contacts">
  <h2>Как со мной связаться</h2>
  <p class="about-contacts-lead">
    Быстрее всего — <a href="/contact">через форму</a>: письмо сразу уходит в нужный ящик.
    Если удобнее почтой, вот адреса по темам.
  </p>
  <ul class="about-mails">
    <% mails.forEach(function (m) { %>
      <li><a href="mailto:<%= m.address %>"><%= m.address %></a> <span><%= m.note %></span></li>
    <% }); %>
  </ul>

  <% linkGroups.forEach(function (group) { %>
    <% if (group.name) { %><h3 class="about-links-title"><%= group.name %></h3><% } %>
    <div class="link-grid">
      <% group.items.forEach(function (link) { %>
        <a class="link-card" href="<%= link.url %>" <% if (link.url.startsWith('http')) { %>target="_blank" rel="noopener"<% } %>><%= link.label %></a>
      <% }); %>
    </div>
  <% }); %>
</section>

<%- include('partials/footer') %>
