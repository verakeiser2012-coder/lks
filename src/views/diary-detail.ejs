<%- include('partials/header') %>

<article>
  <div class="news-date"><%= formatDate(post.created_at) %></div>
  <h1><%= post.title %></h1>

  <%# Обложка на странице записи не показывается большим полотном: она нужна
      карточке в списке и превью ссылок, а здесь идёт первым кадром в ленте. %>
  <%# Текст с кадрами в нужных местах: строка «[[кадр N]]» в записи → врезка N-го
      кадра галереи. Врезки всплывают при прокрутке (reveal, скрипт ниже). %>
  <% (typeof blocks !== 'undefined' ? blocks : [{ type: 'text', text: post.content }]).forEach(function (b) { %>
    <% if (b.type === 'media') { %>
      <figure class="diary-inline reveal" <% if (b.item.title) { %>title="<%= b.item.title %>"<% } %>>
        <% if (b.item.type === 'photo') { %>
          <img src="<%= thumb(b.item.file_path, 960) %>" srcset="<%= srcset(b.item.file_path, [640, 960, 1280]) %>" sizes="(max-width: 760px) 92vw, 720px" alt="<%= b.item.title || post.title %>" loading="lazy">
        <% } else if (b.item.file_path.indexOf('http') === 0) { %>
          <div class="gallery-embed-frame"><iframe src="<%= b.item.file_path %>" loading="lazy" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen frameborder="0"></iframe></div>
        <% } else { %>
          <video src="<%= b.item.file_path %>" controls playsinline preload="metadata"></video>
        <% } %>
        <% if (b.item.title) { %><figcaption><%= b.item.title %></figcaption><% } %>
      </figure>
    <% } else { %>
      <div class="prose"><%- renderLinkedText(b.text) %></div>
    <% } %>
  <% }); %>

  <% if (typeof drop !== 'undefined' && drop) { %>
    <%# Дроп, о котором запись: карточка как в списке дропов, только компактнее. %>
    <a class="drop-card diary-drop <%= drop.cover_image ? 'drop-card-art' : '' %>" href="/drops/<%= drop.slug %>">
      <% if (drop.cover_image) { %>
        <img class="diary-drop-cover" src="<%= thumb(drop.cover_image, 480) %>" srcset="<%= srcset(drop.cover_image, [320, 480, 640]) %>" sizes="(max-width: 560px) 92vw, 200px" alt="<%= drop.name %>" loading="lazy">
      <% } %>
      <div class="diary-drop-body">
        <span class="drop-season">Дроп<%= drop.season_label ? ' · ' + drop.season_label : '' %></span>
        <span class="drop-name"><%= drop.name %></span>
        <% if (drop.subtitle) { %><span class="drop-subtitle"><%= drop.subtitle %></span><% } %>
        <span class="diary-drop-more"><%= drop.productCount ? 'Смотреть вещи дропа →' : 'К странице дропа →' %></span>
      </div>
    </a>
  <% } %>
</article>

<%# Фото и видео к записи — обычной плиткой, без киноплёнки: все кадры записи,
    включая врезанные в текст. Подпись показывается при наведении, клик — лайтбокс. %>
<% if (media.length > 0) { %>
  <section class="link-section">
    <h2>Кадры к записи</h2>
    <div class="diary-grid">
      <% media.forEach(function (item) { %>
        <% var isEmbed = item.type === 'video' && item.file_path.indexOf('http') === 0; %>
        <figure class="gallery-item diary-grid__item <%= isEmbed ? 'is-embed' : '' %>" <% if (item.title) { %>title="<%= item.title %>"<% } %>>
          <% if (item.type === 'photo') { %>
            <img src="<%= thumb(item.file_path, 480) %>" srcset="<%= srcset(item.file_path, [320, 480, 640]) %>" sizes="(max-width: 560px) 46vw, 240px" alt="<%= item.title || post.title %>" loading="lazy">
          <% } else if (isEmbed) { %>
            <div class="gallery-embed-frame"><iframe src="<%= item.file_path %>" loading="lazy" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen frameborder="0"></iframe></div>
          <% } else { %>
            <video src="<%= item.file_path %>" muted loop playsinline preload="metadata"></video>
          <% } %>
          <% if (item.title) { %><figcaption class="diary-grid__caption"><%= item.title %></figcaption><% } %>
        </figure>
      <% }); %>
    </div>
  </section>
<% } %>

  <% if (post.dzen_url) { %>
    <p class="diary-dzen-note">
      Эта запись также опубликована в Дзене: <a href="<%= post.dzen_url %>" target="_blank" rel="noopener">читать там →</a>
    </p>
  <% } %>

<%# Лента времени: все записи дневника киноплёнкой, как под новостью. Текущая
    запись подсвечена и прокручивается в кадр (news-strip.js). %>
<% if (allPosts.length > 1) { %>
  <section style="margin-top:40px;">
    <h2>Все записи дневника</h2>
    <div class="filmstrip filmstrip--timeline" id="news-timeline">
      <div class="filmstrip-track">
        <% allPosts.forEach(function(p, idx) { %>
          <% const d = p.created_at; const mark = d.slice(8, 10) + '.' + d.slice(5, 7) + '.' + d.slice(2, 4); %>
          <% const entryWord = (typeof lang !== 'undefined' && lang === 'en') ? 'ENTRY' : 'ЗАПИСЬ'; %>
          <div class="film-cell <%= p.id === post.id ? 'current' : '' %>" data-code="LEVKEYSER · 35 MM" data-num="<%= entryWord %> <%= String(idx + 1).padStart(2, '0') %> · <%= mark %>">
          <a class="news-frame" href="/diary/<%= p.slug %>" <%= p.id === post.id ? 'data-current="1"' : '' %>>
            <% if (p.cover_image) { %>
              <img src="<%= thumb(p.cover_image, 320) %>" alt="" loading="lazy">
            <% } else { %>
              <div class="no-image">Нет фото</div>
            <% } %>
            <div class="news-frame-caption">
              <div class="news-frame-date"><%= formatDateShort(p.created_at) %></div>
              <div class="news-frame-title"><%= p.title %></div>
            </div>
          </a>
          </div>
        <% }); %>
      </div>
    </div>
  </section>
<% } %>

<%# Оценка записи, как в школьном дневнике. Игра, а не рейтинг: двойку тоже
    можно поставить, и это честнее, чем сердечки, где вариант всегда один. %>
<section class="diary-marks" data-slug="<%= post.slug %>">
  <h2 class="diary-marks-title">Поставьте оценку записи</h2>
  <p class="diary-marks-hint">Дневник же. Оценку можно поменять, засчитается последняя.</p>
  <div class="diary-marks-row" role="group" aria-label="Оценка записи">
    <% [2, 3, 4, 5].forEach(function (m) { %>
      <button type="button" class="diary-mark" data-mark="<%= m %>"><%= m %></button>
    <% }); %>
  </div>
  <p class="diary-marks-score" id="diary-marks-score"<%= marksCount ? '' : ' hidden' %>>
    Средний балл <strong id="diary-marks-avg"><%= marksAvg %></strong>
    <span class="diary-marks-count" id="diary-marks-count"><%= marksCount %></span>
  </p>
</section>

<p style="margin-top:24px;"><a href="/diary">← Ко всем записям</a></p>

<%- include('partials/channel-cta', { channelCtaTitle: 'Обсуждаем в канале', channelCtaText: 'Короткие записи между большими — там.' }) %>

<%- include('partials/share') %>

<script src="/js/diary-marks.js?v=<%= assetVer %>" defer></script>
<script>
  // автопрокрутка ленты времени к текущей записи
  document.addEventListener('DOMContentLoaded', function () {
    var current = document.querySelector('#news-timeline [data-current]');
    if (current && current.scrollIntoView) {
      current.scrollIntoView({ block: 'nearest', inline: 'center' });
      window.scrollTo(0, 0);
    }
    // врезки всплывают, когда доезжаешь до них
    var items = document.querySelectorAll('.reveal');
    if (!('IntersectionObserver' in window) || !items.length) {
      items.forEach(function (el) { el.classList.add('is-in'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.15 });
    items.forEach(function (el) { io.observe(el); });
  });
</script>

<%- include('partials/footer') %>
