<%- include('partials/header') %>

<article>
  <div class="news-date"><%= formatDate(post.created_at) %></div>
  <h1><%= post.title %></h1>

  <%# Обложка — кадр, а не полотно во всю высоту: ограничена по высоте и кадрируется. %>
  <% if (post.cover_image) { %>
    <img class="diary-cover" src="<%= thumb(post.cover_image, 960) %>" srcset="<%= srcset(post.cover_image, [640, 960, 1280]) %>" sizes="(max-width: 760px) 92vw, 720px" alt="<%= post.title %>">
  <% } %>

  <div class="prose"><%- renderLinkedText(post.content) %></div>

  <% if (typeof drop !== 'undefined' && drop) { %>
    <%# Дроп, о котором запись: карточка как в списке дропов, только компактнее. %>
    <a class="drop-card diary-drop <%= drop.cover_image ? 'drop-card-art' : '' %>" href="/drops/<%= drop.slug %>">
      <% if (drop.cover_image) { %>
        <img class="diary-drop-cover" src="<%= thumb(drop.cover_image, 480) %>" srcset="<%= srcset(drop.cover_image, [320, 480, 640]) %>" sizes="(max-width: 560px) 92vw, 200px" alt="<%= drop.name %>" loading="lazy">
      <% } %>
      <div class="diary-drop-body">
        <span class="drop-season">Дроп<%= drop.season_label ? ' · ' + drop.season_label : '' %></span>
        <span class="drop-name"><%= drop.name %></span>
        <% if (drop.subtitle) { %><span class="drop-subtitle"><%= drop.subtitle %></span><% } %>
        <span class="diary-drop-more"><%= drop.productCount ? 'Смотреть вещи дропа →' : 'К странице дропа →' %></span>
      </div>
    </a>
  <% } %>
</article>

<%# Фото и видео к записи — той же киноплёнкой, что на главной и в разделах. %>
<%- include('partials/gallery-section', { galleryItems: media, galleryTitle: 'Кадры к записи' }) %>

  <% if (post.dzen_url) { %>
    <p class="diary-dzen-note">
      Эта запись также опубликована в Дзене: <a href="<%= post.dzen_url %>" target="_blank" rel="noopener">читать там →</a>
    </p>
  <% } %>

<% if (otherPosts.length > 0) { %>
  <section style="margin-top:40px;">
    <h2>Ещё в дневнике</h2>
    <div class="news-list">
      <% otherPosts.forEach(function(p) { %>
        <a class="news-card" href="/diary/<%= p.slug %>">
          <div class="news-card-image">
            <% if (p.cover_image) { %>
              <img src="<%= thumb(p.cover_image, 640) %>" srcset="<%= srcset(p.cover_image) %>" sizes="(max-width: 640px) 92vw, (max-width: 1000px) 46vw, 300px" alt="<%= p.title %>">
            <% } else { %>
              <div class="no-image">Нет фото</div>
            <% } %>
          </div>
          <div>
            <div class="news-date"><%= formatDate(p.created_at) %></div>
            <div class="news-title"><%= p.title %></div>
          </div>
        </a>
      <% }); %>
    </div>
  </section>
<% } %>

<%# Оценка записи, как в школьном дневнике. Игра, а не рейтинг: двойку тоже
    можно поставить, и это честнее, чем сердечки, где вариант всегда один. %>
<section class="diary-marks" data-slug="<%= post.slug %>">
  <h2 class="diary-marks-title">Поставьте оценку записи</h2>
  <p class="diary-marks-hint">Дневник же. Оценку можно поменять, засчитается последняя.</p>
  <div class="diary-marks-row" role="group" aria-label="Оценка записи">
    <% [2, 3, 4, 5].forEach(function (m) { %>
      <button type="button" class="diary-mark" data-mark="<%= m %>"><%= m %></button>
    <% }); %>
  </div>
  <p class="diary-marks-score" id="diary-marks-score"<%= marksCount ? '' : ' hidden' %>>
    Средний балл <strong id="diary-marks-avg"><%= marksAvg %></strong>
    <span class="diary-marks-count" id="diary-marks-count"><%= marksCount %></span>
  </p>
</section>

<p style="margin-top:24px;"><a href="/diary">← Ко всем записям</a></p>

<%- include('partials/channel-cta', { channelCtaTitle: 'Обсуждаем в канале', channelCtaText: 'Короткие записи между большими — там, четыре раза в неделю.' }) %>

<%- include('partials/share') %>

<script src="/js/diary-marks.js" defer></script>

<%- include('partials/footer') %>
