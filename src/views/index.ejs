<%- include('partials/header') %>

<section class="hero">
  <h1><%= settings.site_name %></h1>
  <% if (settings.site_tagline) { %><p class="hero-tagline"><%= settings.site_tagline %></p><% } %>
  <%# Пояснять «добро пожаловать, смотрите каталог» не нужно: девиз уже сказан
      выше, а манифест идёт следом. Герою остаётся только развести по двум
      главным дорогам — музыка и вещи. %>
  <div class="hero-actions">
    <a class="btn" href="/music">Слушать музыку</a>
    <a class="btn btn-ghost" href="/catalog">Каталог</a>
  </div>
</section>

<section class="slow-strip">
  <%# Маскоты Темп и Василий временно скрыты — вернуть, когда будут доделаны. %>
  <div>
    <p class="slow-strip-motto">Двигаюсь медленно в быстром мире</p>
    <p class="slow-strip-en">Slow in a fast world</p>
    <p class="slow-strip-text">Пока нейросеть пишет трек за десять секунд, я свожу бас третий день. Музыка без ИИ, съёмки на плёнку, вещи маленькими тиражами — не потому что не умею быстрее, а потому что процесс важнее скорости.</p>
  </div>
</section>

<% if (news.length > 0) { %>
<section>
  <h2>Новости</h2>
  <div class="news-list">
    <% news.forEach(function(post) { %>
      <a class="news-card" href="/news/<%= post.slug %>">
        <div class="news-card-image">
          <% if (coverByNewsId[post.id]) { %>
            <img src="<%= coverByNewsId[post.id] %>" alt="<%= post.title %>">
          <% } else { %>
            <div class="no-image">Нет фото</div>
          <% } %>
        </div>
        <div>
          <div class="news-date"><%= formatDate(post.created_at, 'ru') %></div>
          <div class="news-title"><%= post.title %></div>
        </div>
      </a>
    <% }); %>
  </div>
  <p><a href="/news">Все новости →</a></p>
</section>
<% } %>

<section>
  <h2>Новые товары</h2>
  <% if (products.length === 0) { %>
    <p>Товаров пока нет.</p>
  <% } else { %>
    <div class="product-grid">
      <% products.forEach(function(product) { %>
        <a class="product-card" href="/catalog/<%= product.slug %>">
          <div class="product-image edge-soft">
            <% if (product.image) { %>
              <img src="<%= product.image %>" alt="<%= product.name %>">
            <% } else { %>
              <div class="no-image">Нет фото</div>
            <% } %>
          </div>
          <div class="product-name"><%= product.name %></div>
          <div class="product-price"><%= formatPrice(product.price) %></div>
        </a>
      <% }); %>
    </div>
  <% } %>
</section>

<%- include('partials/gallery-section', { galleryItems: galleryItems, galleryTitle: 'Моменты' }) %>

<%- include('partials/footer') %>
